time:
  - platform: pcf85063
    id: pcf_rtc
    i2c_id: pmic_i2c
    address: 0x51
    update_interval: 4294967295ms
    timezone: PST8PDT,M3.2.0,M11.1.0
  - platform: sntp
    id: sntp_time
    on_time_sync:
      - then:
          - pcf85063.write_time: {}
    timezone: PST8PDT,M3.2.0,M11.1.0
    update_interval: 15min
    servers:
      - 0.pool.ntp.org
      - 1.pool.ntp.org
      - 2.pool.ntp.org
switch:
  - platform: gpio
    pin:
      number: 7
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    id: amplifier_enable
    name: 'Audio: Amplifier Power'
    restore_mode: ALWAYS_ON
    inverted: false
    disabled_by_default: false
    interlock_wait_time: 0ms
  - platform: template
    name: 'Audio: Codecs Enabled'
    id: audio_codecs_enabled
    icon: mdi:audio-input-stereo-minijack
    restore_mode: DISABLED
    lambda: !lambda |-
      return id(audio_runtime_active);
    turn_off_action:
      then:
        - lambda: !lambda |-
            id(no_audio_at_boot) = true;
            esphome::global_preferences->sync();
        - script.execute:
            id: pmic_audio_power_action_script
            pmic_action: 0
    turn_on_action:
      then:
        - lambda: !lambda |-
            id(no_audio_at_boot) = false;
            esphome::global_preferences->sync();
        - script.execute:
            id: audio_logical_power_up_script
    disabled_by_default: false
    optimistic: false
    assumed_state: false
  - platform: template
    name: 'Display: Enabled'
    id: display_enabled
    icon: mdi:monitor
    restore_mode: DISABLED
    lambda: !lambda |-
      return id(display_runtime_active);
    turn_off_action:
      then:
        - lambda: !lambda |-
            id(no_display_at_boot) = true;
            esphome::global_preferences->sync();
        - script.execute:
            id: display_power_down_script
    turn_on_action:
      then:
        - lambda: !lambda |-
            id(no_display_at_boot) = false;
            esphome::global_preferences->sync();
        - script.execute:
            id: display_power_up_script
    disabled_by_default: false
    optimistic: false
    assumed_state: false
audio_dac:
  - platform: es8311
    id: es8311_dac
    i2c_id: pmic_i2c
    address: 0x18
    bits_per_sample: 16.0
    mic_gain: 42DB
    sample_rate: 16000
    use_mclk: true
    use_microphone: false
audio_adc:
  - platform: es7210
    id: es7210_adc
    i2c_id: pmic_i2c
    address: 0x40
    mic_gain: 30.0
    bits_per_sample: 16.0
    sample_rate: 16000
i2s_audio:
  - id: i2s_output
    i2s_mclk_pin: 14
    i2s_bclk_pin: 15
    i2s_lrclk_pin: 16
speaker:
  - platform: i2s_audio
    id: board_speaker
    i2s_audio_id: i2s_output
    i2s_dout_pin: 17
    audio_dac: es8311_dac
    channel: mono
    sample_rate: 16000
    bits_per_sample: 16.0
    i2s_mode: primary
    use_apll: false
    mclk_multiple: 256
    buffer_duration: 500ms
    timeout: 500ms
    i2s_comm_fmt: stand_i2s
    spdif_mode: false
    dac_type: external
    num_channels: 1
    min_bits_per_sample: 8
    max_bits_per_sample: 32
    min_channels: 1
    max_channels: 2
    min_sample_rate: 16000
    max_sample_rate: 48000
media_player:
  - platform: speaker
    name: 'Audio: Speaker'
    id: photo_speaker_media_player
    volume_min: 0.0
    volume_max: 1.0
    announcement_pipeline:
      speaker: board_speaker
      format: FLAC
      num_channels: 1
      sample_rate: 16000
    disabled_by_default: false
    buffer_size: 1000000
    volume_increment: 0.05
    volume_initial: 0.5
microphone:
  - platform: i2s_audio
    id: board_mic
    i2s_audio_id: i2s_output
    i2s_din_pin: 18
    pdm: false
    channel: right
    sample_rate: 16000
    bits_per_sample: 32.0
    i2s_mode: primary
    use_apll: false
    mclk_multiple: 256
    correct_dc_offset: false
    adc_type: external
    num_channels: 1
    min_bits_per_sample: 32.0
    max_bits_per_sample: 32.0
    min_channels: 1
    max_channels: 1
    min_sample_rate: 16000
    max_sample_rate: 16000
number:
  - platform: template
    name: 'Audio: Volume'
    id: audio_scaled_volume
    icon: mdi:volume-high
    min_value: 0.0
    max_value: 100.0
    step: 5.0
    unit_of_measurement: '%'
    initial_value: 50.0
    restore_value: true
    optimistic: true
    on_value:
      - then:
          - speaker.volume_set:
              id: board_speaker
              volume: !lambda |-
                return 0.30f + ((x / 100.0f) * 0.55f);
    disabled_by_default: false
    mode: AUTO
    update_interval: 60s
  - platform: template
    name: 'Audio: Mic Gain'
    id: mic_gain_slider
    icon: mdi:microphone-plus
    min_value: 8.0
    max_value: 32.0
    step: 1.0
    initial_value: 16.0
    restore_value: true
    optimistic: true
    on_value:
      - then:
          - lambda: !lambda |-
              id(mic_gain_multiplier) = static_cast<int32_t>(x);
    disabled_by_default: false
    mode: AUTO
    update_interval: 60s
rtttl:
  - id: rtttl_player
    speaker: board_speaker
    gain: 0.6
button:
  - platform: template
    name: 'Audio: Play Final Countdown'
    id: play_tune_button
    icon: mdi:music-note
    on_press:
      - then:
          - switch.turn_on:
              id: amplifier_enable
          - rtttl.play:
              id: rtttl_player
              rtttl: FinalCount:d=4,o=5,b=125:8a#,8g#,2a#,2d#,2p,8a#,8g#,2a#,2f,2d#,8a#,8g#,2a#,2d#,2c#,8c,8c#,8c,2a#
    disabled_by_default: false
  - platform: template
    name: 'Audio: Record Voice Note (5s)'
    id: record_voice_note_button
    icon: mdi:microphone
    on_press:
      - then:
          - if:
              condition:
                lambda: !lambda |-
                  return id(audio_runtime_active) && !id(board_speaker).is_running();
              then:
                - script.execute:
                    id: record_voice_note_script
              else:
                - logger.log:
                    tag: voice_note
                    level: WARN
                    format: 'Record ignored: audio is powered down or the speaker
                      holds the I2S bus.'
                    args: []
    disabled_by_default: false
  - platform: template
    name: 'Audio: Play Voice Note'
    id: play_voice_note_button
    icon: mdi:volume-high
    on_press:
      - then:
          - if:
              condition:
                lambda: !lambda |-
                  return id(audio_runtime_active) && !id(board_mic).is_running();
              then:
                - script.execute:
                    id: play_voice_note_script
              else:
                - logger.log:
                    tag: voice_note
                    level: WARN
                    format: 'Playback ignored: audio is powered down or the microphone
                      holds the I2S bus.'
                    args: []
    disabled_by_default: false
  - platform: template
    name: 'Power: Restart'
    id: power_restart_button
    icon: mdi:restart
    on_press:
      - then:
          - if:
              condition:
                lambda: !lambda |-
                  return id(display_runtime_active);
              then:
                - script.execute:
                    id: display_prepare_for_restart_script
                - script.wait:
                    id: display_prepare_for_restart_script
          - if:
              condition:
                lambda: !lambda |-
                  return id(shared_i2c_available);
              then:
                - script.execute:
                    id: pmic_audio_power_action_script
                    pmic_action: 1
              else:
                - logger.log:
                    tag: power_control
                    level: WARN
                    format: Shared I2C is unavailable; using the verified ESP restart
                      path so startup can restore the audio rail.
                    args: []
                - lambda: !lambda |-
                    App.safe_reboot();
    disabled_by_default: false
sensor:
  - platform: shtcx
    id: environment_sensor
    i2c_id: pmic_i2c
    temperature:
      id: temperature
      name: 'Environment: Temperature'
      disabled_by_default: false
      force_update: false
      unit_of_measurement: °C
      accuracy_decimals: 1
      device_class: temperature
      state_class: measurement
    humidity:
      id: humidity
      name: 'Environment: Humidity'
      disabled_by_default: false
      force_update: false
      unit_of_measurement: '%'
      accuracy_decimals: 1
      device_class: humidity
      state_class: measurement
    address: 0x70
    update_interval: 60s
  - platform: template
    name: 'Power USB-C: Voltage'
    id: usb_voltage
    unit_of_measurement: V
    device_class: voltage
    accuracy_decimals: 2
    update_interval: 60s
    lambda: !lambda |-
      // Check if USB power is present (REG 0x00 bit 5)
      uint8_t status = 0, reg_status = 0x00;
      if (id(pmic_i2c).write_readv(0x34, &reg_status, 1, &status, 1) != esphome::i2c::ERROR_OK)
        return {};
      if ((status & 0x20) == 0) return 0.0f; // USB unplugged

      // Ensure VBUS ADC channel is enabled (REG 0x30 bit 2)
      uint8_t adc_en = 0, reg_adc = 0x30;
      if (id(pmic_i2c).write_readv(0x34, &reg_adc, 1, &adc_en, 1) == esphome::i2c::ERROR_OK) {
        if ((adc_en & 0x04) == 0) {
          uint8_t write_data[2] = {0x30, static_cast<uint8_t>(adc_en | 0x04)};
          id(pmic_i2c).write(0x34, write_data, 2);
        }
      }

      // Read VBUS 14-bit ADC registers (0x38 MSB, 0x39 LSB)
      uint8_t msb = 0, lsb = 0;
      uint8_t reg_msb = 0x38, reg_lsb = 0x39;
      if (id(pmic_i2c).write_readv(0x34, &reg_msb, 1, &msb, 1) == esphome::i2c::ERROR_OK &&
          id(pmic_i2c).write_readv(0x34, &reg_lsb, 1, &lsb, 1) == esphome::i2c::ERROR_OK) {
        uint16_t mv = ((msb & 0x3F) << 8) | lsb; // 1 LSB = 1 mV
        return mv / 1000.0f;
      }
      return {};
    disabled_by_default: false
    force_update: false
  - platform: template
    name: 'Power Li-ion Battery: Voltage'
    id: battery_voltage
    unit_of_measurement: V
    device_class: voltage
    accuracy_decimals: 2
    update_interval: 60s
    lambda: !lambda |-
      uint8_t st = 0, sreg = 0x00;
      if (id(pmic_i2c).write_readv(0x34, &sreg, 1, &st, 1) != esphome::i2c::ERROR_OK)
        return {};
      if ((st & 0x08) == 0) return {};        // no battery present -> unavailable
      uint8_t msb = 0, lsb = 0;
      uint8_t reg_msb = 0x34, reg_lsb = 0x35;
      if (id(pmic_i2c).write_readv(0x34, &reg_msb, 1, &msb, 1) == esphome::i2c::ERROR_OK &&
          id(pmic_i2c).write_readv(0x34, &reg_lsb, 1, &lsb, 1) == esphome::i2c::ERROR_OK) {
        uint16_t mv = ((msb & 0x3F) << 8) | lsb;   // 14-bit: REG 0x34[5:0]=vbat[13:8], 0x35=vbat[7:0]
        return mv / 1000.0f;
      }
      return {};
    disabled_by_default: false
    force_update: false
  - platform: template
    name: 'Power Li-ion Battery: Level'
    id: battery_level
    unit_of_measurement: '%'
    device_class: battery
    accuracy_decimals: 0
    update_interval: 180s
    lambda: !lambda |-
      uint8_t st = 0, sreg = 0x00;
      if (id(pmic_i2c).write_readv(0x34, &sreg, 1, &st, 1) != esphome::i2c::ERROR_OK)
        return {};
      if ((st & 0x08) == 0) return {};        // no battery present -> unavailable
      uint8_t pct = 0;
      uint8_t reg = 0xA4;
      if (id(pmic_i2c).write_readv(0x34, &reg, 1, &pct, 1) == esphome::i2c::ERROR_OK) {
        if (pct <= 100) return (float)pct;
      }
      return {};
    disabled_by_default: false
    force_update: false
  - platform: template
    name: 'SD Card: Total Space'
    id: sd_total_space
    unit_of_measurement: MB
    accuracy_decimals: 0
    update_interval: 300s
    lambda: !lambda |-
      if (!id(sd_mounted)) return {};
      uint64_t total = 0, free = 0;
      if (esp_vfs_fat_info("/sdcard", &total, &free) == ESP_OK) {
        return total / (1024.0 * 1024.0);
      }
      return {};
    disabled_by_default: false
    force_update: false
  - platform: template
    name: 'SD Card: Free Space'
    id: sd_free_space
    unit_of_measurement: MB
    accuracy_decimals: 0
    update_interval: 300s
    lambda: !lambda |-
      if (!id(sd_mounted)) return {};
      uint64_t total = 0, free = 0;
      if (esp_vfs_fat_info("/sdcard", &total, &free) == ESP_OK) {
        return free / (1024.0 * 1024.0);
      }
      return {};
    disabled_by_default: false
    force_update: false
  - platform: template
    name: 'SD Card: Used Space'
    id: sd_used_space
    unit_of_measurement: MB
    accuracy_decimals: 0
    update_interval: 300s
    lambda: !lambda |-
      if (!id(sd_mounted)) return {};
      uint64_t total = 0, free = 0;
      if (esp_vfs_fat_info("/sdcard", &total, &free) == ESP_OK) {
        return (total - free) / (1024.0 * 1024.0);
      }
      return {};
    disabled_by_default: false
    force_update: false
  - platform: wifi_signal
    name: 'Status: WiFi Signal'
    id: wifi_signal_dbm
    update_interval: 60s
    disabled_by_default: false
    force_update: false
    unit_of_measurement: dBm
    accuracy_decimals: 0
    device_class: signal_strength
    state_class: measurement
    entity_category: diagnostic
  - platform: uptime
    name: 'Status: Uptime'
    id: uptime_seconds
    disabled_by_default: false
    force_update: false
    unit_of_measurement: s
    icon: mdi:timer-outline
    accuracy_decimals: 0
    device_class: duration
    state_class: total_increasing
    entity_category: diagnostic
    update_interval: 60s
    type: seconds
  - platform: debug
    free:
      name: 'Status: Free Heap'
      id: free_heap_bytes
      disabled_by_default: false
      force_update: false
      unit_of_measurement: B
      icon: mdi:counter
      accuracy_decimals: 0
      state_class: measurement
      entity_category: diagnostic
    psram:
      name: 'Status: Free PSRAM'
      id: free_psram_bytes
      disabled_by_default: false
      force_update: false
      unit_of_measurement: B
      icon: mdi:counter
      accuracy_decimals: 0
      state_class: measurement
      entity_category: diagnostic
binary_sensor:
  - platform: template
    name: 'Power Li-ion Battery: Charging'
    id: battery_charging
    device_class: battery_charging
    lambda: !lambda |-
      // Cached by peripheral_state_poll; this lambda runs every main-loop pass.
      if (!id(axp_state_valid)) return {};
      return (id(axp_status2) & 0x60) == 0x20;  // bits 6:5 == 01 = charge
    disabled_by_default: false
  - platform: gpio
    pin:
      number: 4
      inverted: true
      mode:
        input: true
        pullup: true
        output: false
        open_drain: false
        pulldown: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    name: 'Button: KEY'
    on_press:
      - then:
          - button.press:
              id: play_tune_button
    disabled_by_default: false
    use_interrupt: true
    interrupt_type: ANY
  - platform: gpio
    pin:
      number: 0
      ignore_strapping_warning: true
      inverted: true
      mode:
        input: true
        pullup: true
        output: false
        open_drain: false
        pulldown: false
      ignore_pin_validation_error: false
      drive_strength: 20.0
    name: 'Button: BOOT'
    disabled_by_default: false
    use_interrupt: true
    interrupt_type: ANY
  - platform: template
    name: 'Power Connected: USB-C'
    id: usb_connected
    device_class: plug
    lambda: !lambda |-
      // Cached by peripheral_state_poll; this lambda runs every main-loop pass.
      if (!id(axp_state_valid)) return {};
      return (id(axp_status1) & 0x20) != 0; // Checks Bit 5 (VBUS Present)
    disabled_by_default: false
  - platform: template
    name: 'Power Connected: Li-ion Battery'
    id: battery_connected
    device_class: power
    lambda: !lambda |-
      // Cached by peripheral_state_poll; this lambda runs every main-loop pass.
      if (!id(axp_state_valid)) return {};
      return (id(axp_status1) & 0x08) != 0; // Checks Bit 3 (BAT_PRESENT)
    disabled_by_default: false
  - platform: template
    name: 'Status: TF Connector (TFX-18-001P) Mounted'
    id: sd_card_mounted
    lambda: !lambda |-
      return id(sd_mounted);
    disabled_by_default: false
  - platform: template
    name: 'Status: RTC (PCF85063ATL)'
    id: rtc_running
    lambda: !lambda |-
      // PCF85063 REG 0x04 bit 7 (OS): 1 = oscillator stopped / clock integrity lost.
      // Reported inverted: TRUE = running/healthy. Note: the pcf85063 component and
      // SNTP write_time clear this bit, so after first time-sync it reads healthy
      // unless the clock actually lost power since. It is an integrity flag, not a
      // live "is the crystal ticking right now" probe.
      // Cached by peripheral_state_poll; this lambda runs every main-loop pass.
      if (!id(rtc_state_valid)) return {};
      return (id(rtc_seconds_reg) & 0x80) == 0;
    disabled_by_default: false
  - platform: template
    name: 'Status: Display (7.3in Spectra E6)'
    id: display_status
    lambda: !lambda |-
      return id(display_runtime_active);
    disabled_by_default: false
  - platform: template
    name: 'Status: Display Power Rail (ALDO4)'
    id: aldo4_rail_status
    device_class: power
    lambda: !lambda |-
      // ON = AXP2101 REG 0x90 bit 3 (ALDO4 enable) is set. Sourced from the
      // PMIC register rather than display_runtime_active, so this still
      // reflects the actual rail state if software tracking drifts from it.
      // Cached by peripheral_state_poll; this lambda runs every main-loop pass.
      if (!id(axp_state_valid)) return {};
      return (id(axp_ldo_enable) & 0x08) != 0;
    disabled_by_default: false
  - platform: template
    name: 'Status: Audio Amp (NS4150B)'
    id: ns4150b_status
    lambda: !lambda |-
      return id(amplifier_enable).state;
    disabled_by_default: false
  - platform: template
    name: 'Status: Audio DAC (ES8311)'
    id: es8311_status
    lambda: !lambda |-
      if (!id(audio_runtime_active)) return false;
      // ON = codec ACKs on I2C (0x18) = powered and present. Probed by
      // peripheral_state_poll; this lambda runs every main-loop pass.
      return id(es8311_present);
    disabled_by_default: false
  - platform: template
    name: 'Status: Audio ADC (ES7210)'
    id: es7210_status
    lambda: !lambda |-
      if (!id(audio_runtime_active)) return false;
      // ON = ADC ACKs on I2C (0x40) = powered and present. Probed by
      // peripheral_state_poll; this lambda runs every main-loop pass.
      return id(es7210_present);
    disabled_by_default: false
  - platform: template
    name: 'Status: Audio New Voice Note'
    id: unread_voice_note_sensor
    icon: mdi:email-mark-as-unread
    lambda: !lambda |-
      return id(unread_voice_note);
    disabled_by_default: false
output:
  - platform: gpio
    pin:
      number: 42
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    id: led_1_out_act_amber
    inverted: true
  - platform: gpio
    pin:
      number: 45
      ignore_strapping_warning: true
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      drive_strength: 20.0
    id: led_2_out_pwd_red
    inverted: true
light:
  - platform: binary
    name: 'LED: ACT'
    id: led_act_light
    output: led_1_out_act_amber
    disabled_by_default: false
    restore_mode: ALWAYS_OFF
  - platform: binary
    name: 'LED: PWR'
    id: led_pwr_light
    output: led_2_out_pwd_red
    disabled_by_default: false
    restore_mode: ALWAYS_OFF
display:
  - platform: epaper_spi
    spi_id: display_spi
    id: epaper_display
    model: 7.3IN-SPECTRA-E6
    cs_pin:
      number: 9
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    dc_pin:
      number: 8
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    busy_pin:
      number: 13
      inverted: true
      mode:
        input: true
        output: false
        open_drain: false
        pullup: false
        pulldown: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    reset_pin:
      number: 12
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    update_interval: 900s
    rotation: 180
    lambda: !lambda |-
      id(display_render_started_ms) = millis();
      Color COLOR_BLACK(0, 0, 0);
      Color COLOR_WHITE(255, 255, 255);
      Color COLOR_YELLOW(255, 255, 0);
      Color COLOR_RED(255, 0, 0);
      Color COLOR_BLUE(0, 0, 255);
      Color COLOR_GREEN(0, 255, 0);

      it.fill(COLOR_WHITE);

      // Helper function: Dithered (Light Blue) Rectangle
        auto draw_dithered_rectangle = [&](int rx, int ry, int rw, int rh, Color c1, Color c2) {
          for (int py = ry; py < ry + rh; py++) {
            for (int px = rx; px < rx + rw; px++) {
              // Alternating 50/50 checkerboard pattern
              if ((px + py) % 2 == 0) {
                it.draw_pixel_at(px, py, c1);
              } else {
                it.draw_pixel_at(px, py, c2);
              }
            }
          }
        };

        // ESPHome Logo with Dithered Light-Blue Background
        auto draw_esphome_logo = [&](int x, int y) {
          // Roof (Dithered Blue + White)
          for (int i = 0; i < 18; i++) {
            for (int px = x + 18 - i; px <= x + 18 + i; px++) {
              if ((px + (y + i)) % 2 == 0) {
                it.draw_pixel_at(px, y + i, COLOR_BLUE);
              } else {
                it.draw_pixel_at(px, y + i, COLOR_WHITE);
              }
            }
          }

          // House Base (50% Dithered Light-Blue)
          draw_dithered_rectangle(x + 2, y + 18, 33, 17, COLOR_BLUE, COLOR_WHITE);

          // PCB Antenna Meander Trace (Solid White)
          it.filled_rectangle(x + 9, y + 14, 3, 18, COLOR_WHITE);
          it.filled_rectangle(x + 9, y + 14, 18, 2, COLOR_WHITE);
          it.filled_rectangle(x + 25, y + 14, 2, 4, COLOR_WHITE);
          it.filled_rectangle(x + 14, y + 17, 13, 2, COLOR_WHITE);
          it.filled_rectangle(x + 14, y + 17, 2, 4, COLOR_WHITE);
          it.filled_rectangle(x + 14, y + 20, 13, 2, COLOR_WHITE);
          it.filled_rectangle(x + 25, y + 20, 2, 4, COLOR_WHITE);
          it.filled_rectangle(x + 14, y + 23, 13, 2, COLOR_WHITE);
          it.filled_rectangle(x + 14, y + 23, 2, 4, COLOR_WHITE);
          it.filled_rectangle(x + 14, y + 26, 13, 2, COLOR_WHITE);
        };

        draw_esphome_logo(30, 20);

      // Header Bar (Title shifted right to X = 75)
      it.print(75, 25, id(font_title), COLOR_RED, "Waveshare ESP32-S3-PhotoPainter");

      // Phone-style status icons (signal bars + battery), no identifying text
      {
        bool wifi_ok = id(wifi_signal_dbm).has_state();
        float rssi = wifi_ok ? id(wifi_signal_dbm).state : -100.0f;
        int bars_lit = 0;
        if (rssi >= -55) bars_lit = 4;
        else if (rssi >= -65) bars_lit = 3;
        else if (rssi >= -75) bars_lit = 2;
        else if (rssi >= -85) bars_lit = 1;

        const int bar_w = 6, bar_gap = 3, bar_baseline = 28;
        const int bar_heights[4] = {6, 11, 16, 21};
        int bar_x = 693;
        for (int i = 0; i < 4; i++) {
          int h = bar_heights[i];
          Color fill = (wifi_ok && i < bars_lit) ? COLOR_BLACK : COLOR_WHITE;
          it.filled_rectangle(bar_x, bar_baseline - h, bar_w, h, fill);
          it.rectangle(bar_x, bar_baseline - h, bar_w, h, COLOR_BLACK);
          bar_x += bar_w + bar_gap;
        }

        if (id(battery_connected).has_state() && id(battery_connected).state) {
          const int bx = 736, by = 10, bw = 26, bh = 14;
          it.rectangle(bx, by, bw, bh, COLOR_BLACK);
          it.filled_rectangle(bx + bw, by + 4, 3, bh - 8, COLOR_BLACK);

          float level = id(battery_level).has_state() ? id(battery_level).state : 0.0f;
          bool charging = id(battery_charging).has_state() && id(battery_charging).state;
          int fill_w = static_cast<int>((bw - 4) * (level / 100.0f));
          if (fill_w < 0) fill_w = 0;
          if (fill_w > bw - 4) fill_w = bw - 4;
          if (fill_w > 0) {
            Color fill = charging ? COLOR_YELLOW : (level < 20 ? COLOR_RED : COLOR_GREEN);
            it.filled_rectangle(bx + 2, by + 2, fill_w, bh - 4, fill);
          }
        }
      }

      // Timestamp (Font size reduced to font_body)
      if (id(pcf_rtc).now().is_valid()) {
        it.strftime(770, 32, id(font_body), COLOR_BLACK, TextAlign::TOP_RIGHT, "%Y-%m-%d  %H:%M", id(pcf_rtc).now());
      } else {
        it.print(770, 32, id(font_body), COLOR_BLACK, TextAlign::TOP_RIGHT, "Syncing time...");
      }

      // Uptime, grouped with the date/time rather than the System box below
      if (id(uptime_seconds).has_state()) {
        uint32_t secs = static_cast<uint32_t>(id(uptime_seconds).state);
        uint32_t days = secs / 86400;
        uint32_t hours = (secs % 86400) / 3600;
        uint32_t mins = (secs % 3600) / 60;
        if (days > 0) {
          it.printf(770, 52, id(font_body), COLOR_BLACK, TextAlign::TOP_RIGHT, "Up: %lud %luh", days, hours);
        } else {
          it.printf(770, 52, id(font_body), COLOR_BLACK, TextAlign::TOP_RIGHT, "Up: %luh %lum", hours, mins);
        }
      } else {
        it.print(770, 52, id(font_body), COLOR_BLACK, TextAlign::TOP_RIGHT, "Up: --");
      }

      it.line(30, 75, 770, 75, COLOR_BLACK);

      // Section 1: Environment -- two boxes sharing the original outline
      it.rectangle(28, 83, 359, 149, COLOR_BLACK);

      it.rectangle(30, 85, 174, 145, COLOR_GREEN);
      it.rectangle(31, 86, 172, 143, COLOR_GREEN);
      it.print(45, 95, id(font_header), COLOR_BLACK, "ENVIRONMENT");

      if (id(temperature).has_state()) {
        it.printf(45, 130, id(font_body), COLOR_BLACK, "Temp: %.1f °C", id(temperature).state);
      } else {
        it.print(45, 130, id(font_body), COLOR_BLACK, "Temp: -- °C");
      }

      if (id(humidity).has_state()) {
        it.printf(45, 165, id(font_body), COLOR_BLACK, "Humidity: %.1f %%", id(humidity).state);
      } else {
        // @patched-pending-test finding-3-literal-percent
        // PATCHED 2026-08-31 (code review finding 3) -- NOT YET TESTED ON HARDWARE.
        it.print(45, 165, id(font_body), COLOR_BLACK, "Humidity: -- %");
      }

      it.rectangle(210, 85, 175, 145, COLOR_GREEN);
      it.rectangle(211, 86, 173, 143, COLOR_GREEN);
      it.print(225, 95, id(font_header), COLOR_BLACK, "AUDIO");

      // @patched-pending-test begin fragile-16-unguarded-number-state
      // PATCHED 2026-08-31 (code review fragile item 16) -- NOT YET TESTED ON HARDWARE.
      // These were the only two values on the panel read without has_state();
      // safe in practice because TemplateNumber::setup() publishes
      // initial_value, but they would render "nan" if that ever stopped being
      // true. Guarded to match every other field here.
      if (id(audio_scaled_volume).has_state()) {
        it.printf(225, 130, id(font_body), COLOR_BLACK, "Volume: %.0f %%", id(audio_scaled_volume).state);
      } else {
        it.print(225, 130, id(font_body), COLOR_BLACK, "Volume: -- %");
      }

      if (id(mic_gain_slider).has_state()) {
        it.printf(225, 165, id(font_body), COLOR_BLACK, "Mic Gain: %.0f", id(mic_gain_slider).state);
      } else {
        it.print(225, 165, id(font_body), COLOR_BLACK, "Mic Gain: --");
      }
      // @patched-pending-test end fragile-16-unguarded-number-state

      bool voice_note_unread = id(unread_voice_note_sensor).has_state() && id(unread_voice_note_sensor).state;
      it.printf(225, 200, id(font_body), voice_note_unread ? COLOR_GREEN : COLOR_BLACK,
                "Voice Note: %s", voice_note_unread ? "Unread" : "None");

      // Section 2: Power & Battery
      it.rectangle(413, 83, 359, 149, COLOR_BLACK);
      it.rectangle(415, 85, 355, 145, COLOR_BLUE);
      it.rectangle(416, 86, 353, 143, COLOR_BLUE);
      it.print(430, 95, id(font_header), COLOR_BLACK, "POWER & BATTERY");

      bool usb_on = id(usb_connected).has_state() && id(usb_connected).state;
      bool bat_on = id(battery_connected).has_state() && id(battery_connected).state;
      bool is_charging = id(battery_charging).has_state() && id(battery_charging).state;

      // Left Column (X = 430)
      it.printf(430, 130, id(font_body), COLOR_BLACK, "USB: %s",
                usb_on ? "Connected" : "Disconnected");

      if (id(usb_voltage).has_state()) {
        it.printf(430, 170, id(font_body), COLOR_BLACK, "Voltage: %.2f V", id(usb_voltage).state);
      } else {
        it.print(430, 170, id(font_body), COLOR_BLACK, "Voltage: -- V");
      }

      // Right Column (Center of rectangle: X = 592)
      it.printf(592, 130, id(font_body), COLOR_BLACK, "Li-ion: %s",
                bat_on ? "Present" : "Missing");

      if (id(battery_level).has_state()) {
        it.printf(592, 150, id(font_body), COLOR_BLACK, "Level: %.0f %%", id(battery_level).state);
      } else {
        // @patched-pending-test finding-3-literal-percent
        // PATCHED 2026-08-31 (code review finding 3) -- NOT YET TESTED ON HARDWARE.
        it.print(592, 150, id(font_body), COLOR_BLACK, "Level: -- %");
      }

      if (id(battery_voltage).has_state()) {
        it.printf(592, 170, id(font_body), COLOR_BLACK, "Voltage: %.2f V", id(battery_voltage).state);
      } else {
        it.print(592, 170, id(font_body), COLOR_BLACK, "Voltage: -- V");
      }

      it.printf(592, 190, id(font_body), is_charging ? COLOR_GREEN : COLOR_BLACK,
                "Charging: %s", is_charging ? "YES" : "NO");

      // Section 3: SD Card + System -- two boxes sharing the original outline
      it.rectangle(28, 243, 359, 149, COLOR_BLACK);

      it.rectangle(30, 245, 174, 145, COLOR_YELLOW);
      it.rectangle(31, 246, 172, 143, COLOR_YELLOW);
      it.print(45, 255, id(font_header), COLOR_BLACK, "SD CARD");

      bool sd_mounted_st = id(sd_card_mounted).has_state() && id(sd_card_mounted).state;
      it.printf(45, 285, id(font_body), sd_mounted_st ? COLOR_GREEN : COLOR_RED,
                "Mounted: %s", sd_mounted_st ? "Yes" : "No");

      if (sd_mounted_st && id(sd_free_space).has_state()) {
        it.printf(45, 308, id(font_body), COLOR_BLACK, "Free: %.0f MB", id(sd_free_space).state);
      } else {
        it.print(45, 308, id(font_body), COLOR_BLACK, "Free: -- MB");
      }

      if (sd_mounted_st && id(sd_used_space).has_state()) {
        it.printf(45, 331, id(font_body), COLOR_BLACK, "Used: %.0f MB", id(sd_used_space).state);
      } else {
        it.print(45, 331, id(font_body), COLOR_BLACK, "Used: -- MB");
      }

      if (sd_mounted_st && id(sd_total_space).has_state()) {
        it.printf(45, 354, id(font_body), COLOR_BLACK, "Total: %.0f MB", id(sd_total_space).state);
      } else {
        it.print(45, 354, id(font_body), COLOR_BLACK, "Total: -- MB");
      }

      it.rectangle(210, 245, 175, 145, COLOR_YELLOW);
      it.rectangle(211, 246, 173, 143, COLOR_YELLOW);
      it.print(225, 255, id(font_header), COLOR_BLACK, "FREE MEMORY");

      // "Free" is already the box header; item labels omit the word so they
      // don't overrun the box width.
      if (id(free_heap_bytes).has_state()) {
        it.printf(225, 285, id(font_body), COLOR_BLACK, "Heap: %.0f KB", id(free_heap_bytes).state / 1024.0f);
      } else {
        it.print(225, 285, id(font_body), COLOR_BLACK, "Heap: --");
      }

      if (id(free_psram_bytes).has_state()) {
        it.printf(225, 308, id(font_body), COLOR_BLACK, "PSRAM: %.0f KB", id(free_psram_bytes).state / 1024.0f);
      } else {
        it.print(225, 308, id(font_body), COLOR_BLACK, "PSRAM: --");
      }

      // Flash space claimed by no partition (otadata/app0/app1/nvs/phy_init).
      uint32_t flash_total_bytes = 0;
      esp_flash_get_size(nullptr, &flash_total_bytes);
      uint32_t partitions_total_bytes = 0;
      esp_partition_iterator_t part_it = esp_partition_find(ESP_PARTITION_TYPE_ANY, ESP_PARTITION_SUBTYPE_ANY, nullptr);
      while (part_it != nullptr) {
        partitions_total_bytes += esp_partition_get(part_it)->size;
        part_it = esp_partition_next(part_it);
      }
      esp_partition_iterator_release(part_it);
      it.printf(225, 331, id(font_body), COLOR_BLACK, "Flash: %.0f KB",
                (flash_total_bytes - partitions_total_bytes) / 1024.0f);

      // Section 4: Hardware Status
      it.rectangle(413, 243, 359, 149, COLOR_BLACK);
      it.rectangle(415, 245, 355, 145, COLOR_RED);
      it.rectangle(416, 246, 353, 143, COLOR_RED);
      it.print(430, 255, id(font_header), COLOR_BLACK, "HARDWARE STATUS");

      bool rtc_ok = id(rtc_running).has_state() && id(rtc_running).state;
      bool codec_ok = id(es8311_status).has_state() && id(es8311_status).state;
      bool adc_ok = id(es7210_status).has_state() && id(es7210_status).state;
      bool amp_on = id(ns4150b_status).has_state() && id(ns4150b_status).state;

      // @patched-pending-test begin finding-2-led-status-source
      // PATCHED 2026-08-31 (code review finding 2) -- NOT YET TESTED ON HARDWARE.
      // Needs a lit LED plus a forced refresh to confirm on the panel.
      //
      // The LED pins are driven as GPIO_MODE_OUTPUT, which leaves the pad's input
      // buffer disabled; gpio_get_level() is defined to return 0 for such a pin
      // regardless of what is being driven, so read the light state instead. The
      // `inverted: true` on each output means lit == pin LOW, and is_on() already
      // reports the logical (lit) state.
      bool act_on = id(led_act_light).current_values.is_on();
      bool pwr_on = id(led_pwr_light).current_values.is_on();

      // GPIO0/GPIO4 are configured as inputs by their binary_sensor entries, so
      // these reads are valid (Active-Low: LOW / 0 = pressed).
      bool boot_pressed = (gpio_get_level(GPIO_NUM_0) == 0);
      bool key_pressed = (gpio_get_level(GPIO_NUM_4) == 0);

      // Left Column (X = 430)
      it.printf(430, 285, id(font_body), COLOR_BLACK, "RTC: %s", rtc_ok ? "OK" : "ERR");
      it.printf(430, 308, id(font_body), COLOR_BLACK, "ADC: %s", adc_ok ? "OK" : "ERR");
      it.printf(430, 331, id(font_body), COLOR_BLACK, "DAC: %s", codec_ok ? "OK" : "ERR");
      it.printf(430, 354, id(font_body), COLOR_BLACK, "Amp: %s", amp_on ? "ON" : "OFF");

      // Right Column (Center of rectangle: X = 592)
      it.printf(592, 285, id(font_body), COLOR_BLACK, "LED-ACT: %s", act_on ? "ON" : "OFF");
      it.printf(592, 308, id(font_body), COLOR_BLACK, "LED-PWR: %s", pwr_on ? "ON" : "OFF");
      // @patched-pending-test end finding-2-led-status-source
      it.printf(592, 331, id(font_body), COLOR_BLACK, "BTN-KEY: %s", key_pressed ? "PRESSED" : "IDLE");
      it.printf(592, 354, id(font_body), COLOR_BLACK, "BTN-BOOT: %s", boot_pressed ? "PRESSED" : "IDLE");

      // Color Palette Swatches
      it.filled_rectangle(50, 405, 100, 45, COLOR_BLACK);
      it.rectangle(50, 405, 100, 45, COLOR_BLACK);

      it.filled_rectangle(170, 405, 100, 45, COLOR_WHITE);
      it.rectangle(170, 405, 100, 45, COLOR_BLACK);

      it.filled_rectangle(290, 405, 100, 45, COLOR_YELLOW);
      it.rectangle(290, 405, 100, 45, COLOR_BLACK);

      it.filled_rectangle(410, 405, 100, 45, COLOR_RED);
      it.rectangle(410, 405, 100, 45, COLOR_BLACK);

      it.filled_rectangle(530, 405, 100, 45, COLOR_BLUE);
      it.rectangle(530, 405, 100, 45, COLOR_BLACK);

      it.filled_rectangle(650, 405, 100, 45, COLOR_GREEN);
      it.rectangle(650, 405, 100, 45, COLOR_BLACK);
    auto_clear_enabled: unspecified
    data_rate: 20000000.0
    spi_mode: MODE0
    full_update_every: 1

INFO Configuration is valid!
