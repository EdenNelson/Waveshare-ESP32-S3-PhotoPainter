INFO ESPHome 2026.5.1
INFO Reading configuration Waveshare-PhotoPainter.yaml...
INFO Detected timezone 'America/Los_Angeles'
INFO Detected timezone 'America/Los_Angeles'
substitutions:
  name: waveshare-photopainter
  friendly_name: PhotoPainter
  location: Waveshare
esphome:
  name: waveshare-photopainter
  friendly_name: Waveshare - PhotoPainter
  includes:
    - <esp_vfs_fat.h>
    - <sdmmc_cmd.h>
    - <driver/i2c_master.h>
    - <esphome/core/preferences.h>
    - <esp_heap_caps.h>
    - <esp_flash.h>
    - <esp_partition.h>
  on_boot:
    - priority: 790.0
      then:
        - lambda: !lambda |-
            // @diag-only begin boot-pmic-diagnostics
            // Set to 'false' to mute diagnostic logs once working
            const bool VERBOSE_LOGGING = true;
            // @diag-only end boot-pmic-diagnostics

            const uint8_t PMIC_ADDR   = 0x34; // AXP2101 PMIC
            const uint8_t RTC_ADDR    = 0x51; // PCF85063 Real-Time Clock
            const uint8_t SENSOR_ADDR = 0x70; // SHTC3 Temp/Humidity Sensor
            const uint8_t ADC_ADDR    = 0x40; // ES7210 Audio ADC
            const uint8_t CODEC_ADDR  = 0x18; // ES8311 Audio Codec
            const bool DISPLAY_BOOT_ENABLED = !id(no_display_at_boot);

            uint32_t start_time = millis();
            id(shared_i2c_available) = false;

            // @diag-only begin boot-pmic-diagnostics
            if (VERBOSE_LOGGING) {
              ESP_LOGI("axp_diag", "[+%4lu ms] === Starting PMIC & Peripheral Init ===", millis() - start_time);
            }
            // @diag-only end boot-pmic-diagnostics

            auto read_reg = [&](uint8_t reg, uint8_t &val) -> bool {
              return id(pmic_i2c).write_readv(PMIC_ADDR, &reg, 1, &val, 1) == esphome::i2c::ERROR_OK;
            };

            auto write_reg = [&](uint8_t reg, uint8_t val) -> bool {
              uint8_t data[2] = {reg, val};
              return id(pmic_i2c).write(PMIC_ADDR, data, 2) == esphome::i2c::ERROR_OK;
            };

            auto probe_address = [&](uint8_t addr) -> bool {
              uint8_t dummy = 0;
              return id(pmic_i2c).write_readv(addr, nullptr, 0, &dummy, 1) == esphome::i2c::ERROR_OK;
            };

            // 1. Bus recovery & PMIC connection check
            uint8_t chip_id = 0;
            bool bus_ok = false;
            int attempts = 0;

            for (attempts = 1; attempts <= 10; attempts++) {
              if (read_reg(0x03, chip_id)) {
                bus_ok = true;
                break;
              }
              // @diag-only begin boot-pmic-diagnostics
              if (VERBOSE_LOGGING) {
                ESP_LOGW("axp_diag", "[+%4lu ms] Try %d: I2C bus busy/unresponsive. Retrying in 20ms...", millis() - start_time, attempts);
              }
              // @diag-only end boot-pmic-diagnostics
              delay(20);
            }

            if (!bus_ok) {
              ESP_LOGE("axp_diag", "[+%4lu ms] CRITICAL: AXP2101 PMIC failed to respond after %d attempts.", millis() - start_time, attempts - 1);
              return;
            }
            id(shared_i2c_available) = true;

            // @diag-only begin boot-pmic-diagnostics
            if (VERBOSE_LOGGING) {
              ESP_LOGI("axp_diag", "[+%4lu ms] PMIC responsive on try %d! Chip ID: 0x%02X", millis() - start_time, attempts, chip_id);
            }
            // @diag-only end boot-pmic-diagnostics

            // 2. Fetch baseline state
            uint8_t dcdc1 = 0, aldo3 = 0, aldo4 = 0, ldo_en = 0;
            read_reg(0x82, dcdc1);
            read_reg(0x94, aldo3);
            read_reg(0x95, aldo4);
            read_reg(0x90, ldo_en);

            // @diag-only begin boot-pmic-diagnostics
            if (VERBOSE_LOGGING) {
              ESP_LOGI("axp_diag", "[+%4lu ms] Baseline State -> DCDC1: 0x%02X, ALDO3: 0x%02X, ALDO4: 0x%02X, LDO_EN: 0x%02X",
                       millis() - start_time, dcdc1, aldo3, aldo4, ldo_en);
            }
            // @diag-only end boot-pmic-diagnostics

            // 3. Evaluate configuration state & apply power if missing
            bool display_rail_configured = DISPLAY_BOOT_ENABLED
                ? (((aldo4 & 0x1F) == 0x1C) && ((ldo_en & 0x08) != 0))
                : ((ldo_en & 0x08) == 0);
            bool is_configured = (dcdc1 == 0x12) &&
                                 ((aldo3 & 0x1F) == 0x1C) &&
                                 ((ldo_en & 0x04) != 0) &&
                                 display_rail_configured;

            if (is_configured) {
              // @diag-only begin boot-pmic-diagnostics
              if (VERBOSE_LOGGING) {
                ESP_LOGI("axp_diag", "[+%4lu ms] Power rails already active (Warm boot). Skipping power write.", millis() - start_time);
              }
              // @diag-only end boot-pmic-diagnostics
            } else {
              // @diag-only begin boot-pmic-diagnostics
              if (VERBOSE_LOGGING) {
                ESP_LOGI("axp_diag", "[+%4lu ms] Applying startup rails: ALDO3/audio=ON ALDO4/display=%s.",
                         millis() - start_time, DISPLAY_BOOT_ENABLED ? "ON" : "OFF");
              }
              // @diag-only end boot-pmic-diagnostics

              write_reg(0x82, 0x12);                  // DCDC1 -> 3.3V
              write_reg(0x94, (aldo3 & 0xE0) | 0x1C);  // ALDO3 -> 3.3V
              if (DISPLAY_BOOT_ENABLED) {
                write_reg(0x95, (aldo4 & 0xE0) | 0x1C);  // ALDO4 -> 3.3V
              }
              uint8_t desired_ldo_enable = ldo_en | 0x04;  // Always allow static audio setup
              desired_ldo_enable = DISPLAY_BOOT_ENABLED
                  ? static_cast<uint8_t>(desired_ldo_enable | 0x08)
                  : static_cast<uint8_t>(desired_ldo_enable & ~0x08);
              write_reg(0x90, desired_ldo_enable);      // Change ALDO3/ALDO4 only; preserve every other LDO

              // Verification readback
              read_reg(0x82, dcdc1);
              read_reg(0x94, aldo3);
              read_reg(0x95, aldo4);
              read_reg(0x90, ldo_en);

              // @diag-only begin boot-pmic-diagnostics
              if (VERBOSE_LOGGING) {
                ESP_LOGI("axp_diag", "[+%4lu ms] Readback Post-Write -> DCDC1: 0x%02X, ALDO3: 0x%02X, ALDO4: 0x%02X, LDO_EN: 0x%02X",
                         millis() - start_time, dcdc1, aldo3, aldo4, ldo_en);
              }
              // @diag-only end boot-pmic-diagnostics

              delay(100); // Wait for power rails and downstream components to stabilize
            }

            // 4. Selective I2C device probing (Runs safely ONLY after power rails are active)
            // @diag-only begin boot-pmic-diagnostics
            if (VERBOSE_LOGGING) {
              ESP_LOGI("axp_diag", "[+%4lu ms] Probing target downstream I2C devices...", millis() - start_time);

              bool rtc_found = probe_address(RTC_ADDR);
              ESP_LOGI("axp_diag", "[+%4lu ms] RTC (0x%02X): %s",
                       millis() - start_time, RTC_ADDR, rtc_found ? "PRESENT" : "NOT RESPONDING");

              // SHTC3 requires a 16-bit Wakeup Command (0x3517) before it will ACK on I2C
              bool sensor_found = false;
              uint8_t shtc3_wakeup[2] = {0x35, 0x17};
              if (id(pmic_i2c).write(SENSOR_ADDR, shtc3_wakeup, 2) == esphome::i2c::ERROR_OK) {
                sensor_found = true;
                delayMicroseconds(300);
                // Put SHTC3 back to sleep (0xB098) until the ESPHome component initializes
                uint8_t shtc3_sleep[2] = {0xB0, 0x98};
                id(pmic_i2c).write(SENSOR_ADDR, shtc3_sleep, 2);
              }
              ESP_LOGI("axp_diag", "[+%4lu ms] SHTC3 Sensor (0x%02X): %s",
                       millis() - start_time, SENSOR_ADDR, sensor_found ? "PRESENT (Woken from Sleep)" : "NOT RESPONDING");

              bool adc_found = probe_address(ADC_ADDR);
              ESP_LOGI("axp_diag", "[+%4lu ms] ES7210 Audio ADC (0x%02X): %s",
                       millis() - start_time, ADC_ADDR, adc_found ? "PRESENT" : "NOT RESPONDING");

              bool codec_found = probe_address(CODEC_ADDR);
              ESP_LOGI("axp_diag", "[+%4lu ms] ES8311 Audio Codec (0x%02X): %s",
                       millis() - start_time, CODEC_ADDR, codec_found ? "PRESENT" : "NOT RESPONDING");
            }
            // @diag-only end boot-pmic-diagnostics

            // @diag-only begin boot-pmic-diagnostics
            if (VERBOSE_LOGGING) {
              ESP_LOGI("axp_diag", "[+%4lu ms] Initialization complete. Handing over to display component.", millis() - start_time);
            }
            // @diag-only end boot-pmic-diagnostics

            // @diag-only begin peripheral-register-dumps
            // --- ES8311 Codec Register Dump ---
            if (VERBOSE_LOGGING) {
              // Wait for downstream audio_dac/i2s_audio components to finish setup()
              delay(500);

              ESP_LOGI("es8311_diag", "=== ES8311 Post-Init Detailed Register Dump ===");

              auto read_codec_reg = [&](uint8_t reg, uint8_t &val) -> bool {
                return id(pmic_i2c).write_readv(CODEC_ADDR, &reg, 1, &val, 1) == esphome::i2c::ERROR_OK;
              };

              const char *wl_str[8]  = {"24-bit", "20-bit", "18-bit", "16-bit", "32-bit", "Unk", "Unk", "Unk"};
              const char *fmt_str[4] = {"I2S", "Left-Justified", "Reserved", "DSP/PCM"};

              uint8_t consecutive_i2c_fails = 0;

              auto dump_reg = [&](uint8_t reg, const char *category) -> bool {
                uint8_t val = 0;

                // 1. I2C Fault Protection: Abort if hardware becomes unresponsive mid-dump
                if (!read_codec_reg(reg, val)) {
                  consecutive_i2c_fails++;
                  if (consecutive_i2c_fails >= 3) {
                    ESP_LOGE("es8311_diag", "I2C bus unresponsive at reg 0x%02X. Aborting dump.", reg);
                    return false;
                  }
                  return true;
                }
                consecutive_i2c_fails = 0;

                // 2. Buffer Overflow Protection: Zero-initialized, bounded stack buffer
                char extra[96] = {0};

                switch (reg) {
                  case 0x00: // RESET/CTRL
                    snprintf(extra, sizeof(extra), "| CSM:%s, Mode:%s, ResetsActive:0x%02X",
                             (val & 0x80) ? "ON" : "OFF", (val & 0x40) ? "Master" : "Slave", val & 0x1F);
                    break;
                  case 0x01: // CLK_MGR
                    snprintf(extra, sizeof(extra), "| Src:%s, MCLK:%s, BCLK:%s, ADC_CLK:%s, DAC_CLK:%s",
                             (val & 0x80) ? "BCLK" : "MCLK", (val & 0x20) ? "ON" : "OFF",
                             (val & 0x10) ? "ON" : "OFF", (val & 0x08) ? "ON" : "OFF", (val & 0x04) ? "ON" : "OFF");
                    break;
                  case 0x09: // SDP IN (DAC Format)
                    snprintf(extra, sizeof(extra), "| DAC In Mute:%s, WL:%s, Format:%s",
                             (val & 0x40) ? "YES" : "NO", wl_str[(val >> 2) & 0x07], fmt_str[val & 0x03]);
                    break;
                  case 0x0A: // SDP OUT (ADC Format)
                    snprintf(extra, sizeof(extra), "| ADC Out Mute:%s, WL:%s, Format:%s",
                             (val & 0x40) ? "YES" : "NO", wl_str[(val >> 2) & 0x07], fmt_str[val & 0x03]);
                    break;
                  case 0x0D: // SYSTEM POWER 1
                    snprintf(extra, sizeof(extra), "| AnalogPwr:%s, VMID:%u",
                             (val & 0x80) ? "DOWN" : "UP", val & 0x03);
                    break;
                  case 0x0E: // SYSTEM POWER 2
                    snprintf(extra, sizeof(extra), "| PGA:%s, ADC_Modulator:%s",
                             (val & 0x40) ? "DOWN" : "UP", (val & 0x20) ? "DOWN" : "UP");
                    break;
                  case 0x12: // SYSTEM POWER 3
                    snprintf(extra, sizeof(extra), "| DAC:%s, RefBuf:%s",
                             (val & 0x02) ? "DOWN" : "UP", (val & 0x01) ? "ON" : "OFF");
                    break;
                  case 0x13: // OUTPUT DRIVER
                    snprintf(extra, sizeof(extra), "| Output Drive:%s",
                             (val & 0x10) ? "Headphone Driver" : "Line Out");
                    break;
                  case 0x14: // MIC/PGA GAIN
                    snprintf(extra, sizeof(extra), "| DMIC:%s, Input:%s, PGA Gain:+%udB",
                             (val & 0x40) ? "ON" : "OFF", (val & 0x10) ? "MIC1P-MIC1N" : "None",
                             ((val & 0x0F) <= 10) ? (val & 0x0F) * 3 : 30);
                    break;
                  case 0x16: // ADC SCALE
                    snprintf(extra, sizeof(extra), "| ADC Digital Scale Up:+%udB", (val & 0x07) * 6);
                    break;
                  case 0x17: // ADC VOLUME
                    snprintf(extra, sizeof(extra), "| ADC Digital Vol: %.1fdB", (val * 0.5f) - 95.5f);
                    break;
                  case 0x18: // ALC CONTROL
                    snprintf(extra, sizeof(extra), "| ALC:%s, AutoMute:%s",
                             (val & 0x80) ? "ENABLED" : "Disabled", (val & 0x40) ? "ENABLED" : "Disabled");
                    break;
                  case 0x31: // DAC MUTE
                    snprintf(extra, sizeof(extra), "| DSM Mute:%s, DEM Mute:%s, PhaseInvert:%s",
                             (val & 0x40) ? "MUTED" : "unmuted", (val & 0x20) ? "MUTED" : "unmuted",
                             (val & 0x10) ? "180 deg" : "Normal");
                    break;
                  case 0x32: // DAC VOLUME
                    snprintf(extra, sizeof(extra), "| DAC Vol: %.1fdB", (val * 0.5f) - 95.5f);
                    break;
                  case 0x34: // DRC CONTROL
                    snprintf(extra, sizeof(extra), "| Dynamic Range Compression:%s",
                             (val & 0x80) ? "ENABLED" : "Disabled");
                    break;
                  case 0x44: // ROUTING / LOOPBACK
                    snprintf(extra, sizeof(extra), "| Direct Hardware Loopback (ADC->DAC):%s",
                             (val & 0x80) ? "ENABLED" : "Disabled");
                    break;
                  case 0xFD: // CHIP_ID1
                  case 0xFE: // CHIP_ID2
                  case 0xFF: // CHIP_VER
                    snprintf(extra, sizeof(extra), "| Chip Hardware Identification Byte");
                    break;
                }

                ESP_LOGI("es8311_diag", "Reg 0x%02X (%-10s): 0x%02X %s", reg, category, val, extra);
                return true;
              };

              // 3. Integer Overflow Protection: Using uint16_t iterators prevents wraparound at 0xFF
              auto dump_range = [&](uint16_t start, uint16_t end, const char *category) -> bool {
                for (uint16_t r = start; r <= end; r++) {
                  if (!dump_reg(static_cast<uint8_t>(r), category))
                    return false;

                  // 4. Task Watchdog Feeding: Reset FreeRTOS TWDT explicitly & yield execution
                  esphome::App.feed_wdt();
                  delay(1);
                }
                return true;
              };

              bool ok = true;
              if (ok) ok = dump_range(0x00, 0x00, "RESET/CTRL");
              if (ok) ok = dump_range(0x01, 0x08, "CLK_MGR");
              if (ok) ok = dump_range(0x09, 0x0A, "SDP");
              if (ok) ok = dump_range(0x0B, 0x14, "SYSTEM");
              if (ok) ok = dump_range(0x15, 0x1D, "ADC");
              if (ok) ok = dump_range(0x1E, 0x30, "ADCEQ");
              if (ok) ok = dump_range(0x31, 0x37, "DAC");
              if (ok) ok = dump_range(0x38, 0x43, "DACEQ");
              if (ok) ok = dump_range(0x44, 0x44, "GPIO");
              if (ok) ok = dump_range(0x45, 0x45, "GP");
              if (ok) ok = dump_range(0xFA, 0xFA, "I2C");
              if (ok) ok = dump_range(0xFC, 0xFC, "FLAG");
              if (ok) ok = dump_range(0xFD, 0xFF, "CHIP_ID");

              ESP_LOGI("es8311_diag", "=== End ES8311 Register Dump ===");
            }

            // --- ES7210 Audio ADC Register Dump ---
            if (VERBOSE_LOGGING) {
              ESP_LOGI("es7210_diag", "=== ES7210 Post-Init Detailed Register Dump ===");

              auto read_adc_reg = [&](uint8_t reg, uint8_t &val) -> bool {
                return id(pmic_i2c).write_readv(ADC_ADDR, &reg, 1, &val, 1) == esphome::i2c::ERROR_OK;
              };

              const char *wl_str[8]  = {"24-bit", "20-bit", "18-bit", "16-bit", "32-bit", "Unk", "Unk", "Unk"};
              const char *fmt_str[4] = {"I2S", "Left-Justified", "Reserved", "DSP/PCM"};
              const char *csm_str[4] = {"Power Down", "Init", "Normal", "Power Up"};
              const char *vbias_str[8] = {"2.18V", "2.26V", "2.36V", "2.45V", "2.55V", "2.66V", "2.78V", "2.87V"};
              static const float pga_gain_tbl[16] = {0.0f, 3.0f, 6.0f, 9.0f, 12.0f, 15.0f, 18.0f, 21.0f, 24.0f, 27.0f, 30.0f, 33.0f, 34.5f, 36.0f, 37.5f, 37.5f};

              uint8_t consecutive_i2c_fails = 0;

              auto dump_adc_reg = [&](uint8_t reg, const char *category) -> bool {
                uint8_t val = 0;

                // 1. I2C Fault Protection
                if (!read_adc_reg(reg, val)) {
                  consecutive_i2c_fails++;
                  if (consecutive_i2c_fails >= 3) {
                    ESP_LOGE("es7210_diag", "I2C bus unresponsive at reg 0x%02X. Aborting dump.", reg);
                    return false;
                  }
                  return true;
                }
                consecutive_i2c_fails = 0;

                // 2. Buffer Overflow Protection
                char extra[96] = {0};

                switch (reg) {
                  case 0x00: // RESET CONTROL
                    snprintf(extra, sizeof(extra), "| CSM:%s, AutoSeq:%s, ResetsActive:0x%02X",
                             (val & 0x01) ? "ON" : "OFF", (val & 0x08) ? "Disabled" : "Enabled", val & 0x76);
                    break;
                  case 0x01: // CLOCK OFF
                    snprintf(extra, sizeof(extra), "| MCLK:%s, MasterCLK:%s, ADC12_CLK:%s, ADC34_CLK:%s",
                             (val & 0x01) ? "OFF" : "ON", (val & 0x20) ? "OFF" : "ON",
                             (val & 0x08) ? "OFF" : "ON", (val & 0x10) ? "OFF" : "ON");
                    break;
                  case 0x02: // MAIN CLK CONTROL
                    {
                      const char *mult_str[4] = {"x4", "x8", "x1", "x2"};
                      snprintf(extra, sizeof(extra), "| Mult:%s, Div:%u", mult_str[(val >> 6) & 0x03], val & 0x1F);
                    }
                    break;
                  case 0x03: // MASTER CLK CONTROL
                    snprintf(extra, sizeof(extra), "| MCLK Src:%s, SCLK Div:%u",
                             (val & 0x80) ? "Doubler" : "Pad", val & 0x7F);
                    break;
                  case 0x06: // POWER DOWN
                    snprintf(extra, sizeof(extra), "| DLL Pwr:%s, TDMIN PullDown:%s, PullUps:%s",
                             (val & 0x04) ? "DOWN" : "UP", (val & 0x02) ? "OFF" : "ON", (val & 0x01) ? "OFF" : "ON");
                    break;
                  case 0x08: // MODE CONFIG
                    snprintf(extra, sizeof(extra), "| ClockMode:%s, Speed:%s, EQ:%s, SCLK Invert:%s",
                             (val & 0x01) ? "Master" : "Slave", (val & 0x02) ? "Double" : "Single",
                             (val & 0x04) ? "OFF" : "ON", (val & 0x08) ? "YES" : "NO");
                    break;
                  case 0x0B: // CHIP STATUS
                    snprintf(extra, sizeof(extra), "| CSM State:%s", csm_str[val & 0x03]);
                    break;
                  case 0x10: // DMIC CONTROL
                    snprintf(extra, sizeof(extra), "| DMIC12:%s, DMIC34:%s, Gain12:+%udB, Gain34:+%udB",
                             (val & 0x40) ? "ON" : "OFF", (val & 0x80) ? "ON" : "OFF",
                             (val & 0x07) * 6, ((val >> 3) & 0x07) * 6);
                    break;
                  case 0x11: // SDP INTERFACE 1
                    snprintf(extra, sizeof(extra), "| WL:%s, Format:%s, LRP:%s",
                             wl_str[(val >> 5) & 0x07], fmt_str[val & 0x03], (val & 0x10) ? "Inverted" : "Normal");
                    break;
                  case 0x12: // SDP INTERFACE 2
                    {
                      const char *sdout_mode[4] = {"ADC12->SDOUT1/ADC34->SDOUT2", "TDM DSP/PCM", "TDM I2S/LJ", "Multi-LRCK TDM"};
                      snprintf(extra, sizeof(extra), "| Mode:%s, SDOUT1 Tri:%s, SDOUT2 Tri:%s",
                               sdout_mode[val & 0x03], (val & 0x10) ? "YES" : "NO", (val & 0x20) ? "YES" : "NO");
                    }
                    break;
                  case 0x16: // ALC SELECT
                    snprintf(extra, sizeof(extra), "| ALC12 Mode:0x%X, ALC34 Mode:0x%X", (val >> 2) & 0x03, val & 0x03);
                    break;
                  case 0x1B: // ADC4 GAIN
                  case 0x1C: // ADC3 GAIN
                  case 0x1D: // ADC2 GAIN
                  case 0x1E: // ADC1 GAIN
                    {
                      float db = (val <= 0xBF) ? (val * 0.5f - 95.5f) : ((val - 0xBF) * 0.5f);
                      snprintf(extra, sizeof(extra), "| Vol/Max Gain: %.1fdB", db);
                    }
                    break;
                  case 0x3D: // CHIP_ID1
                  case 0x3E: // CHIP_ID0
                  case 0x3F: // CHIP_VER
                    snprintf(extra, sizeof(extra), "| Chip Hardware Identification Byte");
                    break;
                  case 0x40: // ANALOG SYSTEM
                    snprintf(extra, sizeof(extra), "| Analog Pwr:%s, VX2OFF:%s",
                             (val & 0x80) ? "DOWN" : "UP", (val & 0x40) ? "OFF (3.3V)" : "ON");
                    break;
                  case 0x41: // MIC1/2 BIAS
                  case 0x42: // MIC3/4 BIAS
                    snprintf(extra, sizeof(extra), "| Bias Voltage Level: %s", vbias_str[(val >> 4) & 0x07]);
                    break;
                  case 0x43: // MIC1 GAIN
                  case 0x44: // MIC2 GAIN
                  case 0x45: // MIC3 GAIN
                  case 0x46: // MIC4 GAIN
                    snprintf(extra, sizeof(extra), "| Input Select:%s, PGA Gain: +%.1fdB",
                             (val & 0x10) ? "SELECTED" : "Deselected", pga_gain_tbl[val & 0x0F]);
                    break;
                  case 0x4B: // MIC1/2 POWER DOWN
                  case 0x4C: // MIC3/4 POWER DOWN
                    snprintf(extra, sizeof(extra), "| VREF_PDN:%d, MICBIAS_PDN:%d, PGA_PDN:0x%X, MOD_PDN:0x%X",
                             (val & 0x80) >> 7, (val & 0x40) >> 6, (val >> 4) & 0x03, (val >> 2) & 0x03);
                    break;
                }

                ESP_LOGI("es7210_diag", "Reg 0x%02X (%-10s): 0x%02X %s", reg, category, val, extra);
                return true;
              };

              // 3. Integer Overflow Protection (uint16_t bounds)
              auto dump_adc_range = [&](uint16_t start, uint16_t end, const char *category) -> bool {
                for (uint16_t r = start; r <= end; r++) {
                  if (!dump_adc_reg(static_cast<uint8_t>(r), category))
                    return false;

                  // 4. Task Watchdog Feeding
                  esphome::App.feed_wdt();
                  delay(1);
                }
                return true;
              };

              bool ok_adc = true;
              if (ok_adc) ok_adc = dump_adc_range(0x00, 0x00, "RESET");
              if (ok_adc) ok_adc = dump_adc_range(0x01, 0x05, "CLK_MGR");
              if (ok_adc) ok_adc = dump_adc_range(0x06, 0x0A, "SYS_TIME");
              if (ok_adc) ok_adc = dump_adc_range(0x0B, 0x0D, "STATUS/INT");
              if (ok_adc) ok_adc = dump_adc_range(0x10, 0x12, "SDP/DMIC");
              if (ok_adc) ok_adc = dump_adc_range(0x13, 0x15, "ADC_CTRL");
              if (ok_adc) ok_adc = dump_adc_range(0x16, 0x1E, "ALC/GAIN");
              if (ok_adc) ok_adc = dump_adc_range(0x20, 0x23, "HPF");
              if (ok_adc) ok_adc = dump_adc_range(0x24, 0x37, "EQ");
              if (ok_adc) ok_adc = dump_adc_range(0x3D, 0x3F, "CHIP_ID");
              if (ok_adc) ok_adc = dump_adc_range(0x40, 0x42, "ANALOG");
              if (ok_adc) ok_adc = dump_adc_range(0x43, 0x4A, "MIC_GAIN");
              if (ok_adc) ok_adc = dump_adc_range(0x4B, 0x4C, "PWR_DOWN");

              ESP_LOGI("es7210_diag", "=== End ES7210 Register Dump ===");
            }

            // --- PCF85063ATL Full Register Dump (0x00-0x11) with Crash-Safe Decoding ---
            if (VERBOSE_LOGGING) {
              ESP_LOGI("rtc_diag", "=== PCF85063ATL Register Dump ===");

              auto read_rtc_reg = [&](uint8_t reg, uint8_t &val) -> bool {
                return id(pmic_i2c).write_readv(RTC_ADDR, &reg, 1, &val, 1) == esphome::i2c::ERROR_OK;
              };

              const char *rtc_names[] = {
                "Control_1", "Control_2", "Offset", "RAM_byte",
                "Seconds", "Minutes", "Hours", "Days",
                "Weekdays", "Months", "Years",
                "Second_alarm", "Minute_alarm", "Hour_alarm",
                "Day_alarm", "Weekday_alarm", "Timer_value", "Timer_mode"
              };
              const size_t num_rtc_regs = sizeof(rtc_names) / sizeof(rtc_names[0]);

              const char *cof_str[] = {"32.768kHz", "16.384kHz", "8.192kHz", "4.096kHz", "2.048kHz", "1.024kHz", "1Hz", "DISABLED"};
              const char *tcf_str[] = {"4.096kHz", "64Hz", "1Hz", "1/60Hz"};

              for (uint8_t r = 0x00; r <= 0x11; r++) {
                // Safety Guard 1: Prevent out-of-bounds array read if register bounds change
                const char *reg_name = (r < num_rtc_regs) ? rtc_names[r] : "Unknown_Reg";

                uint8_t val = 0;
                if (!read_rtc_reg(r, val)) {
                  ESP_LOGW("rtc_diag", "Reg 0x%02X (%-13s): read failed", r, reg_name);
                  continue;
                }

                // Safety Guard 2: Stack buffer sized comfortably with snprintf null-termination
                char extra[96] = "";

                switch (r) {
                  case 0x00: // Control_1
                    snprintf(extra, sizeof(extra), "| STOP:%s, 12/24h:%s, CapSel:%s",
                             (val & 0x20) ? "STOPPED" : "RUNNING",
                             (val & 0x02) ? "12-hour" : "24-hour",
                             (val & 0x01) ? "12.5pF" : "7pF");
                    break;

                  case 0x01: { // Control_2
                    // Safety Guard 3: Explicit bitmask ensures index stays strictly within [0..7]
                    uint8_t cof_idx = val & 0x07;
                    snprintf(extra, sizeof(extra), "| AIE:%s, AF:%s, TF:%s, CLKOUT:%s",
                             (val & 0x80) ? "ON" : "OFF",
                             (val & 0x40) ? "SET" : "CLEAR",
                             (val & 0x08) ? "SET" : "CLEAR",
                             cof_str[cof_idx]);
                    break;
                  }

                  case 0x02: { // Offset
                    // Safety Guard 4: Convert 7-bit 2's complement (-64 to +63) to signed int8_t safely
                    int8_t offset_val = (val & 0x40) ? (int8_t)(val | 0x80) : (int8_t)(val & 0x7F);
                    snprintf(extra, sizeof(extra), "| Mode:%s, OffsetVal:%d LSBs",
                             (val & 0x80) ? "Fast (4min)" : "Normal (2h)",
                             offset_val);
                    break;
                  }

                  case 0x04: // Seconds
                    snprintf(extra, sizeof(extra), "| OS Flag:%s, Sec:%02X",
                             (val & 0x80) ? "STOPPED (Integrity Lost)" : "OK",
                             val & 0x7F);
                    break;

                  case 0x05: // Minutes
                  case 0x06: // Hours
                  case 0x07: // Days
                  case 0x09: // Months
                  case 0x0A: // Years
                    snprintf(extra, sizeof(extra), "| Raw BCD: 0x%02X", val & 0x7F);
                    break;

                  case 0x11: { // Timer_mode
                    // Safety Guard 5: Explicit bitmask ensures index stays strictly within [0..3]
                    uint8_t tcf_idx = (val >> 3) & 0x03;
                    snprintf(extra, sizeof(extra), "| TE:%s, TIE:%s, Mode:%s, ClockSrc:%s",
                             (val & 0x04) ? "ENABLED" : "Disabled",
                             (val & 0x02) ? "ENABLED" : "Disabled",
                             (val & 0x01) ? "Pulse" : "Level",
                             tcf_str[tcf_idx]);
                    break;
                  }
                }

                ESP_LOGI("rtc_diag", "Reg 0x%02X (%-13s): 0x%02X %s", r, reg_name, val, extra);
              }

              ESP_LOGI("rtc_diag", "=== End PCF85063ATL Register Dump ===");
            }
            // @diag-only end peripheral-register-dumps

            // Mount SD Card over SPI3_HOST
        - lambda: !lambda |-
            sdmmc_host_t host = SDSPI_HOST_DEFAULT();
            host.slot = SPI3_HOST;

            sdspi_device_config_t slot_config = SDSPI_DEVICE_CONFIG_DEFAULT();
            slot_config.gpio_cs = GPIO_NUM_38;
            slot_config.host_id = SPI3_HOST;

            esp_vfs_fat_sdmmc_mount_config_t mount_config = {
                .format_if_mount_failed = false,
                .max_files = 5,
                .allocation_unit_size = 16 * 1024
            };

            sdmmc_card_t *card;
            esp_err_t ret = esp_vfs_fat_sdspi_mount("/sdcard", &host, &slot_config, &mount_config, &card);

            if (ret == ESP_OK) {
              id(sd_mounted) = true;
              ESP_LOGI("sd_card", "SD Card mounted successfully at /sdcard");
            } else {
              id(sd_mounted) = false;
              ESP_LOGE("sd_card", "SD Card mount failed: %s", esp_err_to_name(ret));
            }
        - lambda: !lambda |-
            // PollingComponent::call_setup() would otherwise schedule the first
            // refresh within a few seconds of setup(), often before slower
            // sensors (SD space, battery level) have reported their own first
            // value, leaving the dashboard showing blank placeholders. Suppress
            // it here regardless of the saved display preference; when display
            // should be ON, apply_restored_power_state_script re-enables it
            // later, after sensors have had time to report.
            id(epaper_display).set_update_interval(UINT32_MAX);
            if (id(no_display_at_boot)) {
              ESP_LOGI("display_power", "Saved display state is OFF; initial e-paper refresh is suppressed and ALDO4 remains OFF.");
            }
        - delay: 1ms
        - lambda: !lambda |-
            // Publish the requested effective state immediately. Hardware OFF
            // sequencing may continue asynchronously after component setup, but
            // the live switches should reflect the saved startup intent at boot.
            id(audio_runtime_active) = !id(no_audio_at_boot);
            id(display_runtime_active) = !id(no_display_at_boot);
            ESP_LOGI("power_control", "Restored startup preferences: audio=%s display=%s.",
                     id(no_audio_at_boot) ? "OFF" : "ON",
                     id(no_display_at_boot) ? "OFF" : "ON");
        - delay: 5s
        - script.execute:
            id: apply_restored_power_state_script
  min_version: 2026.5.1
