script:
  - id: shared_i2c_recovery_script
    mode: single
    then:
      - lambda: !lambda |-
          const char *const TAG = "i2c_recovery";
          const uint8_t PMIC_ADDR = 0x34;
          const uint8_t RTC_ADDR = 0x51;
          const uint8_t SENSOR_ADDR = 0x70;

          // @diag-only begin i2c-recovery-diagnostics
          ESP_LOGI(TAG, "=== Shared I2C Recovery Started ===");
          // @diag-only end i2c-recovery-diagnostics

          i2c_master_bus_handle_t bus_handle = nullptr;
          esp_err_t handle_result = i2c_master_get_bus_handle(
              static_cast<i2c_port_num_t>(id(pmic_i2c).get_port()), &bus_handle);
          if (handle_result != ESP_OK || bus_handle == nullptr) {
            ESP_LOGE(TAG, "Cannot obtain ESP-IDF I2C bus handle: %s.", esp_err_to_name(handle_result));
            id(shared_i2c_available) = false;
            return;
          }

          for (uint8_t attempt = 1; attempt <= 3; attempt++) {
            id(shared_i2c_recovery_attempts)++;
            const int before_sda = gpio_get_level(GPIO_NUM_47);
            const int before_scl = gpio_get_level(GPIO_NUM_48);
            // @diag-only begin i2c-recovery-diagnostics
            ESP_LOGW(TAG,
                     "Recovery attempt %u (lifetime %lu): before reset SDA=%d SCL=%d.",
                     attempt, static_cast<unsigned long>(id(shared_i2c_recovery_attempts)),
                     before_sda, before_scl);
            // @diag-only end i2c-recovery-diagnostics

            esp_err_t reset_result = i2c_master_bus_reset(bus_handle);
            delay(25);

            const int after_sda = gpio_get_level(GPIO_NUM_47);
            const int after_scl = gpio_get_level(GPIO_NUM_48);
            uint8_t pmic_id = 0;
            uint8_t rtc_control = 0;
            bool pmic_ok = false;
            bool rtc_ok = false;
            bool sensor_ok = false;

            if (after_sda == 1 && after_scl == 1) {
              uint8_t reg = 0x03;
              pmic_ok = id(pmic_i2c).write_readv(PMIC_ADDR, &reg, 1, &pmic_id, 1) == esphome::i2c::ERROR_OK;

              reg = 0x00;
              rtc_ok = id(pmic_i2c).write_readv(RTC_ADDR, &reg, 1, &rtc_control, 1) == esphome::i2c::ERROR_OK;

              uint8_t wake_command[2] = {0x35, 0x17};
              sensor_ok = id(pmic_i2c).write(SENSOR_ADDR, wake_command, sizeof(wake_command)) == esphome::i2c::ERROR_OK;
              if (sensor_ok) {
                delayMicroseconds(300);
                uint8_t sleep_command[2] = {0xB0, 0x98};
                sensor_ok = id(pmic_i2c).write(SENSOR_ADDR, sleep_command, sizeof(sleep_command)) == esphome::i2c::ERROR_OK;
              }
            }

            // @diag-only begin i2c-recovery-diagnostics
            ESP_LOGW(TAG,
                     "Recovery attempt %u result: reset=%s SDA=%d SCL=%d AXP2101=%s PCF85063=%s SHTC3=%s.",
                     attempt, esp_err_to_name(reset_result), after_sda, after_scl,
                     pmic_ok ? "OK" : "FAILED", rtc_ok ? "OK" : "FAILED",
                     sensor_ok ? "OK" : "FAILED");
            // @diag-only end i2c-recovery-diagnostics

            if (pmic_ok && rtc_ok) {
              id(shared_i2c_available) = true;
              ESP_LOGI(TAG,
                       "Shared I2C recovered: AXP2101 ID=0x%02X PCF85063 Control_1=0x%02X; SHTC3=%s.",
                       pmic_id, rtc_control, sensor_ok ? "OK" : "FAILED");
              return;
            }

            App.feed_wdt();
            delay(100);
          }

          id(shared_i2c_available) = false;
          ESP_LOGE(TAG,
                   "Shared I2C recovery exhausted. The bus remains failed and will be retried; no device errors are being masked.");
    parameters: {}
  - id: record_voice_note_script
    mode: single
    then:
      - lambda: !lambda |-
          if (!id(sd_mounted)) {
            ESP_LOGE("voice_note", "Voice notes are disabled: an SD card is needed and none is mounted.");
            return;
          }

          id(rec_file) = fopen("/sdcard/voice.wav", "wb");
          if (!id(rec_file)) {
            ESP_LOGE("voice_note", "Failed to open /sdcard/voice.wav: %s (errno %d)", strerror(errno), errno);
            return;
          }

          uint8_t dummy_header[44] = {0};
          fwrite(dummy_header, 1, 44, id(rec_file));
          id(rec_bytes) = 0;

          if (!id(rec_cb_registered)) {
            id(board_mic).add_data_callback([](const std::vector<uint8_t> &data) {
              if (id(rec_file) != nullptr && !data.empty()) {
                static std::vector<uint8_t> mono_buf;
                mono_buf.clear();
                mono_buf.reserve(data.size() / 2);

                const int32_t DIGITAL_GAIN = id(mic_gain_multiplier); // set by the "Audio: Mic Gain" number

                // @patched-pending-test begin finding-1-mic-sample-decode
                // PATCHED 2026-08-31 (code review finding 1) -- NOT YET TESTED ON HARDWARE.
                // Compiles clean; correctness confirmed only by reading the
                // i2s_audio microphone source, not by listening to a recording.
                //
                // board_mic delivers mono 32-bit slots at 16 kHz, not interleaved
                // 16-bit stereo: the i2s_audio microphone reports
                // AudioStreamInfo(32, 1, 16000) and hands the raw I2S words to this
                // callback untouched. Each 4-byte group is therefore ONE sample whose
                // meaningful magnitude sits in the high half word; the low half word
                // is the ADC's least-significant bits and is noise at this scale.
                for (size_t i = 0; i + 3 < data.size(); i += 4) {
                  int32_t word = (int32_t)((uint32_t)data[i] |
                                           ((uint32_t)data[i + 1] << 8) |
                                           ((uint32_t)data[i + 2] << 16) |
                                           ((uint32_t)data[i + 3] << 24));

                  // Arithmetic shift keeps the sign; >> 16 is the 16-bit sample.
                  int32_t mix = (word >> 16) * DIGITAL_GAIN;

                  // Saturation clamping to prevent 16-bit audio clipping
                  if (mix > 32767) mix = 32767;
                  if (mix < -32768) mix = -32768;

                  int16_t sample = (int16_t)mix;
                  mono_buf.push_back((uint8_t)(sample & 0xFF));
                  mono_buf.push_back((uint8_t)((sample >> 8) & 0xFF));
                }
                // @patched-pending-test end finding-1-mic-sample-decode

                if (!mono_buf.empty()) {
                  size_t written = fwrite(mono_buf.data(), 1, mono_buf.size(), id(rec_file));
                  id(rec_bytes) += written;
                }
              }
            });
            id(rec_cb_registered) = true;
          }

          ESP_LOGI("voice_note", "Recording 5-second voice note...");
          id(board_mic).start();
      - delay: 5s
      - lambda: !lambda |-
          id(board_mic).stop();

          FILE *f_final = id(rec_file);
          id(rec_file) = nullptr;

          if (f_final != nullptr) {
            fseek(f_final, 0, SEEK_SET);
            uint32_t sample_rate = 16000;
            uint16_t channels = 1;
            uint16_t bits_per_sample = 16;
            uint32_t byte_rate = sample_rate * channels * (bits_per_sample / 8);
            uint16_t block_align = channels * (bits_per_sample / 8);
            uint32_t total_bytes = id(rec_bytes);
            uint32_t chunk_size = 36 + total_bytes;

            uint8_t header[44] = {
              'R', 'I', 'F', 'F',
              (uint8_t)(chunk_size & 0xFF), (uint8_t)((chunk_size >> 8) & 0xFF),
              (uint8_t)((chunk_size >> 16) & 0xFF), (uint8_t)((chunk_size >> 24) & 0xFF),
              'W', 'A', 'V', 'E', 'f', 'm', 't', ' ',
              16, 0, 0, 0, 1, 0, (uint8_t)channels, 0,
              (uint8_t)(sample_rate & 0xFF), (uint8_t)((sample_rate >> 8) & 0xFF),
              (uint8_t)((sample_rate >> 16) & 0xFF), (uint8_t)((sample_rate >> 24) & 0xFF),
              (uint8_t)(byte_rate & 0xFF), (uint8_t)((byte_rate >> 8) & 0xFF),
              (uint8_t)((byte_rate >> 16) & 0xFF), (uint8_t)((byte_rate >> 24) & 0xFF),
              (uint8_t)block_align, 0, (uint8_t)bits_per_sample, 0,
              'd', 'a', 't', 'a',
              (uint8_t)(total_bytes & 0xFF), (uint8_t)((total_bytes >> 8) & 0xFF),
              (uint8_t)((total_bytes >> 16) & 0xFF), (uint8_t)((total_bytes >> 24) & 0xFF)
            };

            fwrite(header, 1, 44, f_final);
            fclose(f_final);

            // @patched-pending-test fragile-13-redundant-publish-state
            // PATCHED 2026-08-31 (code review fragile item 13) -- NOT YET TESTED ON HARDWARE.
            // unread_voice_note_sensor's lambda returns this global and is
            // re-evaluated every main-loop pass, so an explicit publish_state
            // here was overwritten within a millisecond.
            id(unread_voice_note) = true;

            ESP_LOGI("voice_note", "Voice note saved (%lu bytes) to /sdcard/voice.wav", (unsigned long)total_bytes);
          }
    parameters: {}
  - id: play_voice_note_script
    mode: single
    then:
      - lambda: !lambda |-
          if (!id(sd_mounted)) {
            ESP_LOGE("voice_note", "Voice notes are disabled: an SD card is needed and none is mounted.");
            return;
          }
          id(board_speaker).start();
      - wait_until:
          condition:
            lambda: !lambda |-
              return id(board_speaker).is_running();
      - switch.turn_on:
          id: amplifier_enable
      - delay: 50ms
      - lambda: !lambda |-
          FILE *f = fopen("/sdcard/voice.wav", "rb");
          if (!f) {
            ESP_LOGW("voice_note", "No voice note found at /sdcard/voice.wav");
            return;
          }

          fseek(f, 44, SEEK_SET);
          ESP_LOGI("voice_note", "Streaming voice note to speaker...");

          uint8_t buffer[512];
          size_t bytes_read = 0;

          while ((bytes_read = fread(buffer, 1, sizeof(buffer), f)) > 0) {
            size_t bytes_written = 0;

            while (bytes_written < bytes_read) {
              size_t written = id(board_speaker).play(buffer + bytes_written, bytes_read - bytes_written);
              bytes_written += written;

              if (bytes_written < bytes_read) {
                esphome::App.feed_wdt();
                delay(5);
              }
            }
            esphome::App.feed_wdt();
          }

          fclose(f);
      - wait_until:
          condition:
            lambda: !lambda |-
              return !id(board_speaker).has_buffered_data();
      - delay: 200ms
      - lambda: !lambda |-
          id(board_speaker).stop();
          // @patched-pending-test fragile-13-redundant-publish-state
          id(unread_voice_note) = false;
          ESP_LOGI("voice_note", "Playback complete.");
    parameters: {}
  - id: pmic_audio_power_action_script
    mode: single
    parameters:
      pmic_action: int
    then:
      - lambda: !lambda |-
          ESP_LOGW("pmic_power_diag", "=== PMIC AUDIO-SAFE POWER ACTION %d REQUESTED ===", pmic_action);
      - script.stop:
          id: record_voice_note_script
      - script.stop:
          id: play_voice_note_script
      - media_player.stop:
          id: photo_speaker_media_player
          announcement: false
      - rtttl.stop:
          id: rtttl_player
      - microphone.stop_capture:
          id: board_mic
      - speaker.stop:
          id: board_speaker
      - switch.turn_off:
          id: amplifier_enable
      - delay: 250ms
      - lambda: !lambda |-
          const char *const TAG = "pmic_power_diag";
          const uint8_t PMIC_ADDR = 0x34;
          const uint8_t ES8311_ADDR = 0x18;
          const uint8_t ES7210_ADDR = 0x40;

          if (pmic_action < 0 || pmic_action > 2) {
            ESP_LOGE(TAG, "ABORT: unsupported PMIC action %d.", pmic_action);
            return;
          }

          // A stopped recording script does not execute its normal finalization.
          if (id(rec_file) != nullptr) {
            fclose(id(rec_file));
            id(rec_file) = nullptr;
            id(rec_bytes) = 0;
            ESP_LOGW(TAG, "Closed interrupted voice-note file; its WAV header may be invalid.");
          }

          ESP_LOGI(TAG, "Audio clients stopped; amplifier GPIO7 is %s.",
                   id(amplifier_enable).state ? "ON (unexpected)" : "OFF");

          auto read_reg = [&](uint8_t address, uint8_t reg, uint8_t &value) -> bool {
            return id(pmic_i2c).write_readv(address, &reg, 1, &value, 1) == esphome::i2c::ERROR_OK;
          };
          auto write_reg = [&](uint8_t address, uint8_t reg, uint8_t value) -> bool {
            uint8_t data[2] = {reg, value};
            return id(pmic_i2c).write(address, data, sizeof(data)) == esphome::i2c::ERROR_OK;
          };
          auto logged_read = [&](const char *device, uint8_t address, uint8_t reg, uint8_t &value) -> bool {
            bool ok = read_reg(address, reg, value);
            // @diag-only begin pmic-power-diagnostics
            if (ok) {
              ESP_LOGI(TAG, "%s read  [0x%02X] = 0x%02X: OK", device, reg, value);
            }
            // @diag-only end pmic-power-diagnostics
            if (!ok) {
              ESP_LOGE(TAG, "%s read  [0x%02X]: FAILED", device, reg);
            }
            return ok;
          };
          auto logged_write = [&](const char *device, uint8_t address, uint8_t reg, uint8_t value) -> bool {
            bool ok = write_reg(address, reg, value);
            // @diag-only begin pmic-power-diagnostics
            ESP_LOGI(TAG, "%s write [0x%02X] = 0x%02X: %s", device, reg, value,
                     ok ? "OK" : "FAILED");
            // @diag-only end pmic-power-diagnostics
            return ok;
          };
          auto update_bits = [&](const char *device, uint8_t address, uint8_t reg,
                                 uint8_t clear_mask, uint8_t set_mask) -> bool {
            uint8_t before = 0;
            if (!logged_read(device, address, reg, before)) return false;
            uint8_t desired = (before & static_cast<uint8_t>(~clear_mask)) | set_mask;
            // @diag-only begin pmic-power-diagnostics
            ESP_LOGI(TAG, "%s update[0x%02X]: before=0x%02X desired=0x%02X",
                     device, reg, before, desired);
            // @diag-only end pmic-power-diagnostics
            return logged_write(device, address, reg, desired);
          };

          // @diag-only begin pmic-power-diagnostics
          ESP_LOGI(TAG, "Step 1/3: requesting ES8311 power-down state.");
          // @diag-only end pmic-power-diagnostics
          bool codec_ok = true;
          codec_ok &= update_bits("ES8311", ES8311_ADDR, 0x31, 0x00, 0x60);
          codec_ok &= update_bits("ES8311", ES8311_ADDR, 0x00, 0x80, 0x00);
          delay(50);
          uint8_t es8311_csm = 0;
          codec_ok &= logged_read("ES8311", ES8311_ADDR, 0xFC, es8311_csm);
          // @diag-only begin pmic-power-diagnostics
          if (codec_ok) {
            ESP_LOGI(TAG, "ES8311 CSM state=%u (expected 0/S0).", (es8311_csm >> 4) & 0x07);
          }
          // @diag-only end pmic-power-diagnostics
          codec_ok &= update_bits("ES8311", ES8311_ADDR, 0x01, 0x3F, 0x00);

          // @diag-only begin pmic-power-diagnostics
          ESP_LOGI(TAG, "Step 2/3: requesting ES7210 power-down state.");
          // @diag-only end pmic-power-diagnostics
          bool adc_ok = true;
          adc_ok &= update_bits("ES7210", ES7210_ADDR, 0x00, 0x01, 0x00);
          delay(50);
          uint8_t es7210_csm = 0;
          adc_ok &= logged_read("ES7210", ES7210_ADDR, 0x0B, es7210_csm);
          // @diag-only begin pmic-power-diagnostics
          if (adc_ok) {
            ESP_LOGI(TAG, "ES7210 CSM state=%u (expected 0/power-down).", es7210_csm & 0x03);
          }
          // @diag-only end pmic-power-diagnostics
          adc_ok &= logged_write("ES7210", ES7210_ADDR, 0x4B, 0xFF);
          adc_ok &= logged_write("ES7210", ES7210_ADDR, 0x4C, 0xFF);
          adc_ok &= update_bits("ES7210", ES7210_ADDR, 0x40, 0x00, 0x80);
          adc_ok &= update_bits("ES7210", ES7210_ADDR, 0x01, 0x00, 0x7F);
          adc_ok &= update_bits("ES7210", ES7210_ADDR, 0x06, 0x00, 0x07);

          if (!codec_ok || !adc_ok) {
            ESP_LOGE(TAG, "ABORT: at least one codec shutdown operation failed; PMIC command will not be sent.");
            return;
          }

          id(audio_runtime_active) = false;
          // @patched-pending-test fragile-13-redundant-publish-state
          // The status lambdas read these globals every main-loop pass.
          id(es8311_present) = false;
          id(es7210_present) = false;

          if (pmic_action == 0) {
            ESP_LOGI(TAG, "Logical audio shutdown complete. ALDO3 remains ON and shared I2C remains available.");
            return;
          }

          // @diag-only begin pmic-power-diagnostics
          ESP_LOGI(TAG, "Step 3/3: validating AXP2101 before the terminal power command.");
          // @diag-only end pmic-power-diagnostics
          uint8_t ldo_enable = 0;
          uint8_t common_config = 0;
          if (!logged_read("AXP2101", PMIC_ADDR, 0x90, ldo_enable) ||
              !logged_read("AXP2101", PMIC_ADDR, 0x10, common_config)) {
            ESP_LOGE(TAG, "ABORT: AXP2101 state could not be read safely.");
            return;
          }
          // @diag-only begin pmic-power-diagnostics
          ESP_LOGI(TAG, "AXP2101 rails before command: REG90=0x%02X ALDO3=%s ALDO4=%s.",
                   ldo_enable, (ldo_enable & 0x04) ? "ON" : "OFF",
                   (ldo_enable & 0x08) ? "ON" : "OFF");
          ESP_LOGI(TAG, "AXP2101 REG10=0x%02X internal off-discharge=%s.",
                   common_config, (common_config & 0x20) ? "ENABLED" : "disabled");
          ESP_LOGI(TAG, "I2C levels before command: SDA/GPIO47=%d SCL/GPIO48=%d.",
                   gpio_get_level(GPIO_NUM_47), gpio_get_level(GPIO_NUM_48));
          // @diag-only end pmic-power-diagnostics

          if ((ldo_enable & 0x04) == 0) {
            ESP_LOGE(TAG, "ABORT: ALDO3 is already off; refusing a terminal command from an unstable bus state.");
            return;
          }

          // Enable the AXP2101's global internal off-discharge while preserving
          // every unrelated REG10 bit. Set exactly one terminal command bit.
          uint8_t desired = common_config | 0x20;
          if (pmic_action == 1) {
            desired = (desired & static_cast<uint8_t>(~0x01)) | 0x02;
            ESP_LOGW(TAG, "FINAL COMMAND: REG10 0x%02X -> 0x%02X; PMIC power-off/power-on restart should begin now.",
                     common_config, desired);
            ESP_LOGW(TAG, "This is a board power cycle, not an ESP32 soft reset: USB serial will drop now and the "
                          "ESP32 will cold-boot when the PMIC reapplies power. This is expected; reconnect after boot.");
          } else {
            desired = (desired & static_cast<uint8_t>(~0x02)) | 0x01;
            ESP_LOGW(TAG, "FINAL COMMAND: REG10 0x%02X -> 0x%02X; full soft power-off should begin now.",
                     common_config, desired);
            ESP_LOGW(TAG, "USB serial will drop now; this is expected. To power back on, use the physical PWRON "
                          "button; USB removal/reinsertion is the fallback.");
          }

          // Give the asynchronous logger time to emit the final pre-power-loss lines.
          delay(250);
          bool command_ack = write_reg(PMIC_ADDR, 0x10, desired);
          ESP_LOGI(TAG, "AXP2101 terminal command write returned: %s", command_ack ? "OK" : "FAILED/POWER LOST");
          delay(2000);
          ESP_LOGE(TAG, "PMIC command did not remove power within two seconds; inspect REG10 behavior before retrying.");
  - id: audio_logical_power_up_script
    mode: single
    then:
      - lambda: !lambda |-
          const char *const TAG = "audio_power";
          if (!id(shared_i2c_available)) {
            ESP_LOGE(TAG, "Cannot restart codecs: the shared I2C bus is electrically unavailable.");
            return;
          }

          ESP_LOGI(TAG, "Re-running the ESPHome ES8311 and ES7210 setup routines.");
          id(es8311_dac).setup();
          id(es7210_adc).setup();
          delay(100);

          uint8_t es8311_reg = 0xFD, es8311_id = 0;
          uint8_t es7210_reg = 0x3D, es7210_id = 0;
          bool codec_ok = id(pmic_i2c).write_readv(0x18, &es8311_reg, 1, &es8311_id, 1) == esphome::i2c::ERROR_OK;
          bool adc_ok = id(pmic_i2c).write_readv(0x40, &es7210_reg, 1, &es7210_id, 1) == esphome::i2c::ERROR_OK;
          id(audio_runtime_active) = codec_ok && adc_ok;
          // Seed the cache so the status entities do not lag a deliberate
          // power-up by up to one peripheral_state_poll period.
          // @patched-pending-test fragile-13-redundant-publish-state
          id(es8311_present) = codec_ok;
          id(es7210_present) = adc_ok;
          ESP_LOGI(TAG, "Logical audio restart: ES8311=%s (ID 0x%02X), ES7210=%s (ID 0x%02X).",
                   codec_ok ? "OK" : "FAILED", es8311_id, adc_ok ? "OK" : "FAILED", es7210_id);
    parameters: {}
  - id: display_prepare_for_restart_script
    mode: single
    then:
      - lambda: !lambda |-
          ESP_LOGI("display_power", "Waiting for a safe display shutdown point; stopping future refreshes.");
          id(epaper_display).stop_poller();
      - wait_until:
          condition:
            lambda: !lambda |-
              return id(display_render_started_ms) == 0 ||
                     (millis() - id(display_render_started_ms)) >= 40000;
      - lambda: !lambda |-
          id(display_render_started_ms) = 0;
      - wait_until:
          timeout: 5s
          condition:
            lambda: !lambda |-
              return gpio_get_level(GPIO_NUM_13) == 1;
      - lambda: !lambda |-
          if (gpio_get_level(GPIO_NUM_13) != 1) {
            ESP_LOGI("display_power", "BUSY/GPIO13 did not read idle-high within 5s; the panel is very likely "
                                       "already asleep from its last completed refresh. Proceeding with shutdown.");
          }
      - delay: 1s
      - lambda: !lambda |-
          // The Spectra E6 driver already powers off and deep-sleeps after an
          // update. Reissuing its safe-shutdown hook is harmless and explicit.
          id(epaper_display).on_safe_shutdown();
          // @diag-only begin display-power-diagnostics
          ESP_LOGI("display_power", "=== Display safe-shutdown sequence complete ===");
          // @diag-only end display-power-diagnostics
    parameters: {}
  - id: display_power_down_script
    mode: single
    then:
      - script.execute:
          id: display_prepare_for_restart_script
      - script.wait:
          id: display_prepare_for_restart_script
      - delay: 100ms
      - lambda: !lambda |-
          if (!id(shared_i2c_available)) {
            ESP_LOGE("display_power", "Cannot disable ALDO4: the shared I2C bus is electrically unavailable.");
            return;
          }
          uint8_t reg = 0x90, before = 0;
          if (id(pmic_i2c).write_readv(0x34, &reg, 1, &before, 1) != esphome::i2c::ERROR_OK) {
            ESP_LOGE("display_power", "Cannot read AXP2101 REG90; ALDO4 remains unchanged.");
            id(epaper_display).start_poller();
            return;
          }
          const uint8_t desired = before & static_cast<uint8_t>(~0x08);
          uint8_t data[2] = {0x90, desired};
          ESP_LOGW("display_power", "FINAL DISPLAY RAIL COMMAND: REG90 0x%02X -> 0x%02X; clearing ALDO4 only.",
                   before, desired);
          if (id(pmic_i2c).write(0x34, data, sizeof(data)) != esphome::i2c::ERROR_OK) {
            ESP_LOGE("display_power", "AXP2101 did not acknowledge the ALDO4-disable write.");
            id(epaper_display).start_poller();
            return;
          }
          id(display_runtime_active) = false;
          id(epaper_display).set_update_interval(UINT32_MAX);
          ESP_LOGI("display_power", "Display controller is asleep and ALDO4 is OFF.");
    parameters: {}
  - id: display_power_up_script
    mode: single
    then:
      - lambda: !lambda |-
          if (!id(shared_i2c_available)) {
            ESP_LOGE("display_power", "Cannot enable ALDO4 live: the shared I2C bus is electrically unavailable. Apply the staged startup state and restart.");
            return;
          }
          uint8_t reg90 = 0x90, reg95 = 0x95;
          uint8_t enables = 0, aldo4_voltage = 0;
          if (id(pmic_i2c).write_readv(0x34, &reg90, 1, &enables, 1) != esphome::i2c::ERROR_OK ||
              id(pmic_i2c).write_readv(0x34, &reg95, 1, &aldo4_voltage, 1) != esphome::i2c::ERROR_OK) {
            ESP_LOGE("display_power", "Cannot read AXP2101 display-rail state.");
            return;
          }
          uint8_t voltage_data[2] = {0x95, static_cast<uint8_t>((aldo4_voltage & 0xE0) | 0x1C)};
          uint8_t enable_data[2] = {0x90, static_cast<uint8_t>(enables | 0x08)};
          bool voltage_ok = id(pmic_i2c).write(0x34, voltage_data, sizeof(voltage_data)) == esphome::i2c::ERROR_OK;
          bool enable_ok = id(pmic_i2c).write(0x34, enable_data, sizeof(enable_data)) == esphome::i2c::ERROR_OK;
          if (!voltage_ok || !enable_ok) {
            ESP_LOGE("display_power", "Failed to configure or enable ALDO4.");
            return;
          }
          ESP_LOGI("display_power", "ALDO4 is ON; allowing the rail and controller to stabilize before reset/update.");
      - delay: 100ms
      - lambda: !lambda |-
          // start_poller() alone is enough to trigger the refresh: ESPHome's
          // scheduler fires an interval's first execution after a random 0-5s
          // offset, not after the full interval. Also calling update() here
          // raced that near-immediate poller fire against the manual one,
          // logging a spurious "Display already in state POWER_OFF" once the
          // second, redundant update() call was correctly rejected mid-refresh.
          id(display_runtime_active) = true;
          id(epaper_display).set_update_interval(900000);
          id(epaper_display).start_poller();
          ESP_LOGI("display_power", "A reset-driven full display refresh has been requested.");
    parameters: {}
  - id: apply_restored_power_state_script
    mode: single
    then:
      - lambda: !lambda |-
          // @diag-only begin power-state-diagnostics
          ESP_LOGI("power_control", "=== Reconciling restored startup power state ===");
          // @diag-only end power-state-diagnostics
      - if:
          condition:
            lambda: !lambda |-
              return !id(no_audio_at_boot);
          then:
            - script.execute:
                id: audio_logical_power_up_script
            - script.wait:
                id: audio_logical_power_up_script
      - if:
          condition:
            lambda: !lambda |-
              return id(no_display_at_boot);
          then:
            - lambda: !lambda |-
                // Early boot already kept ALDO4 off and suppressed the initial
                // poll, so no SPI shutdown sequence is appropriate here.
                id(epaper_display).stop_poller();
                id(epaper_display).set_update_interval(UINT32_MAX);
                id(display_runtime_active) = false;
                ESP_LOGI("display_power", "Saved display state is OFF; display remains unpowered with no refresh.");
          else:
            - lambda: !lambda |-
                // ALDO4 was restored before component setup, but the initial
                // poller start was suppressed at boot (see on_boot) so the
                // first refresh isn't racing slower sensors. Re-enable it now
                // that setup has finished and sensors have had time to report.
                id(display_runtime_active) = true;
                id(epaper_display).set_update_interval(900000);
                id(epaper_display).start_poller();
                ESP_LOGI("display_power", "Saved display state is ON; requesting the delayed first boot refresh.");
      - if:
          condition:
            lambda: !lambda |-
              return id(no_audio_at_boot);
          then:
            - script.execute:
                id: pmic_audio_power_action_script
                pmic_action: 0
    parameters: {}
interval:
  - interval: 15s
    startup_delay: 15s
    then:
      - if:
          condition:
            lambda: !lambda |-
              return !id(shared_i2c_available);
          then:
            - script.execute:
                id: shared_i2c_recovery_script
  - id: peripheral_state_poll
    interval: 10s
    then:
      - if:
          condition:
            lambda: !lambda |-
              return id(shared_i2c_available);
          then:
            - lambda: !lambda |-
                auto read_reg = [](uint8_t address, uint8_t reg, uint8_t &value) -> bool {
                  return id(pmic_i2c).write_readv(address, &reg, 1, &value, 1) == esphome::i2c::ERROR_OK;
                };

                uint8_t status1 = 0, status2 = 0, ldo_enable = 0;
                bool axp_ok = read_reg(0x34, 0x00, status1) &&
                              read_reg(0x34, 0x01, status2) &&
                              read_reg(0x34, 0x90, ldo_enable);
                if (axp_ok) {
                  id(axp_status1) = status1;
                  id(axp_status2) = status2;
                  id(axp_ldo_enable) = ldo_enable;
                }
                id(axp_state_valid) = axp_ok;

                uint8_t seconds_reg = 0;
                bool rtc_ok = read_reg(0x51, 0x04, seconds_reg);
                if (rtc_ok) {
                  id(rtc_seconds_reg) = seconds_reg;
                }
                id(rtc_state_valid) = rtc_ok;

                // Probing a de-energized codec is pointless and only adds bus
                // traffic; audio_runtime_active already gates the entities.
                if (id(audio_runtime_active)) {
                  uint8_t scratch = 0;
                  id(es8311_present) = read_reg(0x18, 0x00, scratch);
                  id(es7210_present) = id(pmic_i2c).write_readv(0x40, nullptr, 0, &scratch, 1) ==
                                       esphome::i2c::ERROR_OK;
                }
    startup_delay: 0s
i2c:
  - id: pmic_i2c
    sda: 47
    scl: 48
    frequency: 100000.0
    scan: false
    sda_pullup_enabled: true
    scl_pullup_enabled: true
spi:
  - id: display_spi
    interface: spi2
    clk_pin:
      number: 10
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    mosi_pin:
      number: 11
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    type: single
    interface_index: 0
  - id: sd_spi
    interface: spi3
    clk_pin:
      number: 39
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    mosi_pin:
      number: 41
      mode:
        output: true
        input: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    miso_pin:
      number: 40
      mode:
        input: true
        output: false
        open_drain: false
        pullup: false
        pulldown: false
      inverted: false
      ignore_pin_validation_error: false
      ignore_strapping_warning: false
      drive_strength: 20.0
    type: single
    interface_index: 1
